def check_k3s_cluster(r, topo, cluster, c):
    server = c["server"]
    nodes = kubectl_json(server, "get", "nodes")
    if nodes is None:
        r.fail(f"cluster {cluster}: {server}: k3s kubectl get nodes failed")
        return
    live = {n["metadata"]["name"]: n for n in nodes}
    extra = sorted(live.keys() - set(c["nodes"]))
    if extra:
        r.fail(f"cluster {cluster}: nodes not in {TOPOLOGY.name}: {', '.join(extra)}")
    for name in c["nodes"]:
        node = topo["nodes"][name]
        if name not in live:
            r.fail(f"{name}: not a node of cluster {cluster}")
            continue
        ready = any(c["type"] == "Ready" and c["status"] == "True" for c in live[name]["status"]["conditions"])
        region = live[name]["metadata"]["labels"].get("topology.kubernetes.io/region")
        (r.ok if ready and region == node["site"] else r.fail)(
            f"{name}: {'Ready' if ready else 'NOT Ready'} in cluster {cluster}, region {region} (site {node['site']})"
        )
    pods = kubectl_json(server, "-n", DEMO_NAMESPACE, "get", "pods", "-l", f"app={DEMO_APP}") or []
    running = {topo["nodes"].get(p["spec"].get("nodeName"), {}).get("site") for p in pods
               if p["status"].get("phase") == "Running"}
    for site in c["sites"]:
        (r.ok if site in running else r.fail)(f"cluster {cluster}: {DEMO_NAMESPACE}/{DEMO_APP}: "
                                              f"{'a' if site in running else 'no'} running pod in region {site}")


def check_skupper(r, topo):
    """Several clusters (Phase 8): each one's Skupper site Ready and its links to the clusters before it Ready."""
    print(f"Skupper (a site per cluster in namespace {SKUPPER_NAMESPACE}, linked to every earlier cluster)")
    clusters = render.k3s_clusters(topo)
    links = render.cluster_links(topo)
    for cluster, c in clusters.items():
        sites = kubectl_json(c["server"], "-n", SKUPPER_NAMESPACE, "get", "sites") or []
        site = next((x for x in sites if x["metadata"]["name"] == cluster), None)
        status = (site or {}).get("status", {})
        (r.ok if status.get("status") == "Ready" else r.fail)(
            f"cluster {cluster}: site " + (f"{status.get('status')}, {status.get('sitesInNetwork', '?')} sites in "
                                           f"the network" if site else "missing")
        )
        live = kubectl_json(c["server"], "-n", SKUPPER_NAMESPACE, "get", "links") or []
        for src, peer, cost in links:
            if src != cluster:
                continue
            link = next((x for x in live if x["metadata"]["name"].startswith(f"link-{peer}-")), None)
            state = (link or {}).get("status", {}).get("status")
            (r.ok if state == "Ready" else r.fail)(
                f"cluster {cluster}: link to {peer} (cost {cost}) " + (state or "missing")
            )


def vm_query(mon, path, **params):
    """GET a VictoriaMetrics API path on the monitoring node, from inside it."""
    url = f"http://127.0.0.1:{VM_PORT}{path}"
