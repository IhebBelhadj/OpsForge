def check_dns(r, topo):
    print(f"DNS (every node resolves every lab host as <name>.<site>.{render.LAB_DOMAIN} and by short name, and "
          f"{render.GEO_NAME} to its nearest ingress)")
    addrs = render.node_addresses(topo)
    want = {render.gateway_name(s): (s, str(render.gateway_address(site).ip)) for s, site in topo["sites"].items()}
    want |= {n: (topo["nodes"][n]["site"], str(addrs[n].ip)) for n in topo["nodes"]}
    names = [f"{n}.{site}.{render.LAB_DOMAIN}" for n, (site, _) in want.items()] + list(want)
    lookup = 'for n in "$@"; do echo "$n $(getent hosts "$n" | cut -d" " -f1)"; done'
    for node in topo["nodes"]:
        # Geo-aware DNS: with every ingress up, each site's nearest is its own (or the closest other site's)
        geo = render.geo_targets(topo, topo["nodes"][node]["site"])
        expected = {n: want[n.split(".")[0]][1] for n in names} | ({render.GEO_NAME: geo[0][1]} if geo else {})
        out = run_in(node, "sh", "-c", lookup, "sh", *expected).stdout
        got = dict(line.split() for line in out.splitlines() if len(line.split()) == 2)
        wrong = [n for n in expected if got.get(n) != expected[n]]
        msg = f"{node} resolves {len(expected) - len(wrong)}/{len(expected)} names"
        (r.fail if wrong else r.ok)(msg + (f", wrong or missing: {', '.join(wrong)}" if wrong else ""))


