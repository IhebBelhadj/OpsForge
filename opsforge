def cmd_verify(args):
    """Acceptance checks: latency, isolation, internet and bandwidth match topology + live link state (Phase 1);
    SSH access, DNS and PKI once provisioned (Phase 2); with interconnect: vpn, the tunnels (Phase 3); the K3s
    cluster(s), their spread and per-site ingress once installed (Phase 4), Skupper between clusters (Phase 8); monitoring targets and probes (Phase 5); the
    CI/CD node, Flux and the webapp it deploys (Phase 7)."""
    topo = load_valid_topology()
    links = read_link_state()["links"]
    # One probe host per site: its first node, or the gateway if the site has none
    probe = {s: render.gateway_name(s) for s in topo["sites"]}
    for node, n in reversed(topo["nodes"].items()):
        probe[n["site"]] = node
    r = Report()
    check_latency(r, topo, links, probe)
    if topo.get("interconnect") == "vpn":
        check_vpn(r, topo, links, probe)
    else:
        check_isolation(r, topo, probe)
    check_internet(r, topo, probe)
    if not args.quick:
        check_bandwidth(r, topo, links)
    check_ssh(r, [*map(render.gateway_name, topo["sites"]), *topo["nodes"]])
    if provisioned(topo):
        check_dns(r, topo)
        check_pki(r, topo)
        servers = [c["server"] for c in render.k3s_clusters(topo).values()]
        if servers and run_in(servers[0], "test", "-x", "/usr/local/bin/k3s").returncode == 0:
            check_k3s(r, topo)
            if len(render.k3s_clusters(topo)) > 1:
                check_skupper(r, topo)
        if (mon := render.monitoring_node(topo)) and run_in(mon, "test", "-x", "/usr/bin/victoria-metrics").returncode == 0:
            check_monitoring(r, topo)
        if (ci := ci_node(topo)) and run_in(ci, "test", "-x", "/usr/local/bin/gitea").returncode == 0:
            check_ci(r, topo)
    else:
        print("Provisioning")
        r.warn("gateways run no dnsmasq: lab not provisioned, DNS and PKI checks skipped (./opsforge provision)")
    if args.mem is not None:
        check_memory(r, args.mem or MEM_CEILING_MIB[scenario.layout(topo)])
    if args.disk is not None:
        check_disk(r, args.disk or DISK_CEILING_GIB[scenario.layout(topo)])
    print("\nVerify " + ("\033[31mFAILED\033[0m" if r.failed else "\033[32mpassed\033[0m"))
    return 1 if r.failed else 0


