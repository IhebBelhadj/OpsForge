class Report:
    """Collects check results and prints them as OK/WARN/FAIL lines."""

    def __init__(self):
        self.failed = False

    def ok(self, msg):
        print(f"  \033[32mOK\033[0m    {msg}")

    def warn(self, msg):
        print(f"  \033[33mWARN\033[0m  {msg}")

    def fail(self, msg):
        print(f"  \033[31mFAIL\033[0m  {msg}")
        self.failed = True


def incus(*args, check=True):
    # No stdin: given a pipe or socket, some commands (`network create`) wait for YAML config on it
    return subprocess.run(["incus", *args], stdin=subprocess.DEVNULL, capture_output=True, text=True, check=check)


def load_topology(path=TOPOLOGY):
    with open(path) as f:
        return yaml.safe_load(f)


def topology_errors(topo):
    """Schema validation plus cross-reference and address-plan checks the schema can't express."""
    schema = json.loads(SCHEMA.read_text())
    validator = jsonschema.Draft202012Validator(schema, format_checker=jsonschema.FormatChecker())
    errors = [f"{'/'.join(map(str, e.absolute_path)) or '<root>'}: {e.message}" for e in validator.iter_errors(topo)]
    if errors:
        return errors

    sites = topo["sites"]
    transit = ipaddress.ip_network(topo["transit"])
    nets = {"transit": transit}
    public_ips = {}
    for name, site in sites.items():
        vpc = ipaddress.ip_network(site["vpc"])
        nets[f"site {name} vpc"] = vpc
        ip = ipaddress.ip_address(site["public_ip"])
        if ip not in transit:
            errors.append(f"sites/{name}: public_ip {ip} is outside transit {transit}")
        if ip in public_ips.values():
            errors.append(f"sites/{name}: public_ip {ip} is already used")
        public_ips[name] = ip

    named = list(nets.items()) + list(RESERVED_NETS.items())
    for i, (a_name, a) in enumerate(named):
        for b_name, b in named[i + 1 :]:
            if a.overlaps(b) and not (a_name in RESERVED_NETS and b_name in RESERVED_NETS):
                errors.append(f"{a_name} {a} overlaps {b_name} {b}")

    seen_pairs = set()
    for link in topo["links"]:
        a, b = link.split("-")
        for end in (a, b):
            if end not in sites:
                errors.append(f"links/{link}: unknown site '{end}'")
        if a == b:
            errors.append(f"links/{link}: a site cannot link to itself")
        pair = frozenset((a, b))
        if pair in seen_pairs:
            errors.append(f"links/{link}: duplicate link between {a} and {b}")
        seen_pairs.add(pair)

    core = render.core_address(topo)
    if core in public_ips.values():
        errors.append(f"transit: {core} is reserved for {render.WAN_CORE}, not usable as a site public_ip")

    reserved_names = {render.WAN_CORE} | {render.gateway_name(s) for s in sites}
    exposed = set()
    for name, node in topo["nodes"].items():
        if node["site"] not in sites:
            errors.append(f"nodes/{name}: unknown site '{node['site']}'")
            continue
        if name in reserved_names:
            errors.append(f"nodes/{name}: name is reserved for a lab router")
        for spec in node.get("expose", []):
            public, private, proto = render.parse_expose(spec)
            if not (0 < public < 65536 and 0 < private < 65536):
                errors.append(f"nodes/{name}: expose {spec}: ports must be 1-65535")
            if (node["site"], public, proto) in exposed:
                errors.append(f"nodes/{name}: expose {spec}: {public}/{proto} already forwarded on site {node['site']}")
            exposed.add((node["site"], public, proto))
    if not errors:
        for name, addr in render.node_addresses(topo).items():
            site = topo["nodes"][name]["site"]
            vpc = ipaddress.ip_network(sites[site]["vpc"])
            if addr.ip not in vpc or addr.ip == vpc.broadcast_address:
                errors.append(f"nodes/{name}: site {site} VPC {vpc} has no address left for it")
    servers = [n for n, node in topo["nodes"].items() if node["role"] == "k3s-server"]
    if len(servers) > 1:
        errors.append(f"nodes: only one k3s-server is supported per cluster, found {servers}")
    return errors


def cmd_validate(args):
    topo = load_topology(args.topology)
    errors = topology_errors(topo)
    if errors:
        print(f"{args.topology}: {len(errors)} error(s)")
        for e in errors:
            print(f"  - {e}")
        return 1
    print(f"{args.topology}: OK ({len(topo['sites'])} sites, {len(topo['links'])} links, {len(topo['nodes'])} nodes)")
    return 0


def read_sysctl(key):
    try:
        return int(Path("/proc/sys", *key.split(".")).read_text().split()[0])
    except (OSError, ValueError):
        return None


def mem_available_gib():
    for line in Path("/proc/meminfo").read_text().splitlines():
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) * 1024 / GIB
    return 0.0


def cmd_preflight(args):
    r = Report()

    print("Incus")
    if not shutil.which("incus"):
        r.fail("incus not installed (run: sudo ./scripts/host-setup.sh)")
    else:
        r.ok("incus installed")
        try:
            gid = grp.getgrnam("incus-admin").gr_gid
            # newgrp makes it the primary group, which getgroups() may omit
            in_group = gid == os.getegid() or gid in os.getgroups()
        except KeyError:
            in_group = False
        if os.geteuid() == 0 or in_group:
            r.ok("current session is in incus-admin")
        else:
            r.fail("current session not in incus-admin (log out/in or run 'newgrp incus-admin')")
        res = incus("query", "/1.0", check=False)
        if res.returncode != 0:
            r.fail(f"incus daemon not reachable: {res.stderr.strip()}")
        elif incus("storage", "show", "default", check=False).returncode != 0:
            r.fail("storage pool 'default' missing (run: sudo ./scripts/host-setup.sh)")
        else:
            driver = json.loads(incus("query", "/1.0/storage-pools/default").stdout).get("driver")
            r.ok(f"daemon reachable, storage pool 'default' ({driver})")
            used, total = pool_usage()
            (r.ok if used <= POOL_WARN_FRACTION * total else r.warn)(f"pool {describe_pool(used, total)}")

    print("Kernel")
    for mod in REQUIRED_MODULES:
        (r.ok if Path("/sys/module", mod).exists() else r.fail)(f"module {mod}")
    for key, minimum in REQUIRED_SYSCTLS.items():
        value = read_sysctl(key)
        if value is not None and value >= minimum:
            r.ok(f"{key} = {value}")
        else:
            r.fail(f"{key} = {value}, need >= {minimum}")
    subuid = Path("/etc/subuid")
    if subuid.exists() and any(line.startswith("root:") for line in subuid.read_text().splitlines()):
        r.ok("/etc/subuid has a root mapping")
    else:
        r.fail("/etc/subuid has no root mapping")

    print("Host")
    docker_active = subprocess.run(["systemctl", "is-active", "-q", "docker.service"]).returncode == 0
    if not docker_active:
        r.ok("Docker not running (no FORWARD conflict)")
    elif subprocess.run(["systemctl", "is-active", "-q", "opsforge-docker-user.service"]).returncode == 0:
        r.ok("Docker running, opsforge-docker-user.service active")
    else:
        r.fail("Docker running without opsforge-docker-user.service: lab traffic will be dropped")
    free = shutil.disk_usage("/var/lib").free / GIB
    (r.ok if free >= 10 else r.warn)(f"{free:.1f} GiB free on /var/lib (recommend >= 10)")
    avail = mem_available_gib()
    (r.ok if avail >= 3 else r.warn)(f"{avail:.1f} GiB RAM available (recommend >= 3)")
    # Arch removes the running kernel's modules on upgrade: modules not loaded yet (tc, nft, K3s) fail until a reboot
    release = os.uname().release
    if Path("/usr/lib/modules", release).is_dir():
        r.ok(f"running kernel {release} matches the installed modules")
    else:
        r.warn(f"kernel {release} has no /usr/lib/modules/{release}: upgraded but not rebooted (reboot after pacman -Syu)")
    for tool in ("shellcheck", "yamllint", "ansible-lint"):
        if not shutil.which(tool):
            r.warn(f"{tool} missing (make check)")
        elif subprocess.run([tool, "--version"], capture_output=True).returncode != 0:
            # e.g. shellcheck after an Arch partial upgrade (missing Haskell libraries); make check falls back to Docker
            r.warn(f"{tool} installed but broken (partial upgrade? run pacman -Syu)")
        else:
            r.ok(f"{tool} installed")

    print("Topology")
    errors = topology_errors(load_topology())
    (r.fail if errors else r.ok)(f"topology.yml {'has ' + str(len(errors)) + ' error(s): ./opsforge validate' if errors else 'valid'}")

    print("\nPreflight " + ("\033[31mFAILED\033[0m" if r.failed else "\033[32mpassed\033[0m"))
    return 1 if r.failed else 0


def instance_state(name):
    return json.loads(incus("query", f"/1.0/instances/{name}/state").stdout)


def cmd_smoke(args):
    """Phase 0 acceptance: a container boots, gets an address and reaches the internet."""
    incus("delete", "--force", SMOKE_NAME, check=False)
    print(f"Launching {SMOKE_IMAGE} as {SMOKE_NAME} (first run downloads the image)...")
    res = incus("launch", SMOKE_IMAGE, SMOKE_NAME, "--ephemeral", check=False)
    if res.returncode != 0:
        print(res.stderr.strip())
        return 1
    try:
        addr = None
        for _ in range(60):
            nets = instance_state(SMOKE_NAME).get("network") or {}
            addrs = [a["address"] for a in nets.get("eth0", {}).get("addresses", []) if a["family"] == "inet"]
            if addrs:
                addr = addrs[0]
                break
            time.sleep(1)
        if not addr:
            print("FAIL: no IPv4 address on eth0 after 60s (check incusbr0 / host firewall)")
            return 1
        print(f"  eth0 {addr}")

        # DNS via incusbr0's dnsmasq + TCP forwarded through the host: exactly what Docker's FORWARD DROP breaks
        probe = "exec 3<>/dev/tcp/deb.debian.org/80 && echo reachable"
        res = incus("exec", SMOKE_NAME, "--", "timeout", "10", "bash", "-c", probe, check=False)
        if res.returncode != 0:
            print("FAIL: container cannot reach deb.debian.org:80 (DNS or forwarding blocked)")
            return 1
        print("  outbound TCP + DNS OK")

        time.sleep(5)  # let boot-time services settle before measuring
        mem = instance_state(SMOKE_NAME)["memory"]["usage"] / 1024**2
        print(f"  idle memory: {mem:.0f} MiB")
        print("Smoke test passed")
        return 0
    finally:
        incus("delete", "--force", SMOKE_NAME, check=False)


class LabError(Exception):
    pass


def exists(api_path):
    return incus("query", api_path, check=False).returncode == 0


def run_in(name, *cmd):
    return incus("exec", name, "--", *cmd, check=False)


def push_file(name, path, content, mode):
    subprocess.run(
        ["incus", "file", "push", "--create-dirs", "--mode", mode, "-", f"{name}{path}"],
        input=content, text=True, capture_output=True, check=True,
    )


def wait_for(cond, timeout, what):
    for _ in range(timeout):
        if cond():
            return
        time.sleep(1)
    raise LabError(f"timed out after {timeout}s: {what}")


def pool_usage():
    """(used, total) bytes of the `default` storage pool: images and instances together, since btrfs without
    quotas reports no per-instance usage."""
    space = json.loads(incus("query", "/1.0/storage-pools/default/resources").stdout)["space"]
    return space["used"], space["total"]


def describe_pool(used, total):
    return f"{used / GIB:.2f} / {total / GIB:.0f} GiB used ({100 * used / total:.0f} %)"


def lab_instances():
    """Lab instances (tagged user.opsforge.role by `up`), with their state."""
    return [i for i in json.loads(incus("list", "--format", "json").stdout) if "user.opsforge.role" in i["config"]]


def load_valid_topology():
    topo = load_topology()
    errors = topology_errors(topo)
    if errors:
        raise LabError(f"{TOPOLOGY} is invalid, run ./opsforge validate ({len(errors)} error(s))")
    return topo


def upstream_dns():
    """incusbr0's resolver: wan-core forwards the lab's DNS there."""
    return incus("network", "get", "incusbr0", "ipv4.address").stdout.strip().split("/")[0]


def ensure_images():
    for alias, (base, script, description) in render.IMAGES.items():
        if exists(f"/1.0/images/aliases/{alias}"):
            continue
        print(f"Building image {alias} from {base} (one-time)...")
        build = "opsforge-build"
        incus("delete", "--force", build, check=False)
        incus("launch", base, build)
        try:
            incus("exec", build, "--", "sh", "-c", script)
            incus("stop", build)
            incus("publish", build, "--alias", alias, f"description={description}")
        finally:
            incus("delete", "--force", build, check=False)


def ssh_keygen(path, comment):
    if not path.exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", comment, "-f", str(path)], check=True)
    return path.read_text(), path.with_suffix(".pub").read_text()


def wg_keypair(site):
    """(private, public) WireGuard key of a site's gateway, base64 as `wg` uses them. Generated once with openssl
    (WireGuard keys are X25519 keys: the raw 32 bytes ending each key's DER encoding), kept across `down`."""
    pem = WG_KEYS / f"{site}.pem"
    if not pem.exists():
        WG_KEYS.mkdir(mode=0o700, parents=True, exist_ok=True)
        subprocess.run(["openssl", "genpkey", "-algorithm", "X25519", "-out", str(pem)], check=True, capture_output=True)
    der = [
        subprocess.run(["openssl", "pkey", "-in", str(pem), *flags, "-outform", "DER"], check=True, capture_output=True).stdout
        for flags in ([], ["-pubout"])
    ]
    return tuple(base64.b64encode(d[-32:]).decode() for d in der)


def lab_plan(topo):
    """render.plan with this host's upstream DNS and the gateways' real WireGuard keys."""
    keys = {site: wg_keypair(site) for site in topo["sites"]} if topo.get("interconnect") == "vpn" else None
    return render.plan(topo, upstream_dns(), keys)


def write_access(topo, instances):
    """Controller side of SSH and Ansible: keys, SSH config, known_hosts and inventory. Returns the client public key."""
    STATE.mkdir(mode=0o700, exist_ok=True)
    _, client_pub = ssh_keygen(SSH_KEY, "opsforge-controller")
    known = [f"{inst.name} {ssh_keygen(HOST_KEYS / inst.name, inst.name)[1]}" for inst in instances if inst.managed]
    KNOWN_HOSTS.write_text("".join(known))
    SSH_CONFIG.write_text(render.render_ssh_config(topo, SSH_KEY, KNOWN_HOSTS, SSH_DIR))
    INVENTORY.parent.mkdir(parents=True, exist_ok=True)
    inventory = render.render_inventory(topo, SSH_CONFIG, STATE)
    INVENTORY.write_text(render.HEADER + "\n" + yaml.safe_dump(inventory, sort_keys=False))
    return client_pub


def ssh(host, *cmd, timeout=10):
    return subprocess.run(
        ["ssh", "-F", str(SSH_CONFIG), "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", host, *cmd],
        capture_output=True, text=True, timeout=timeout, check=False,
    )


def ssh_ok(host):
    try:
        return ssh(host, "true").returncode == 0
    except subprocess.TimeoutExpired:
        return False


def desired_config(inst):
    """Instance config as `up` sets it: limits, the role/site tags and the fingerprint of its wiring and files."""
    tags = {"user.opsforge.role": inst.role} | ({"user.opsforge.site": inst.site} if inst.site else {})
    return inst.config | tags | {SPEC_KEY: render.fingerprint(inst)}


def config_changes(current, desired):
    return {k: v for k, v in desired.items() if current.get(k) != v}


def nic_changes(devices, nics):
    """(devices to remove, {device: network} to add) turning an instance's NIC devices into `nics`."""
    current = {name: dev.get("network") for name, dev in devices.items() if dev.get("type") == "nic"}
    remove = [name for name, net in current.items() if nics.get(name) != net]
    return remove, {name: net for name, net in nics.items() if current.get(name) != net}


def merge_link_state(live, desired):
    """wan-core's link state after a topology edit: sites and the set of links from topology.yml, but links that
    already exist keep their live conditions, so `up` never undoes `opsforge link` (`link --reset` does)."""
    return desired | {"links": {name: live["links"].get(name, link) for name, link in desired["links"].items()}}


def image_fingerprint(alias):
    return json.loads(incus("query", f"/1.0/images/aliases/{alias}").stdout)["target"]


def lab_networks():
    return [
        net["name"] for net in json.loads(incus("network", "list", "--format", "json").stdout)
        if net["managed"] and net["name"].startswith("of-")
    ]


def close_ssh_masters():
    """Closes our and Ansible's SSH ControlMaster sockets: after an instance restarts they hang the next connection."""
    for sock in [*SSH_DIR.glob("cm-*"), *(Path.home() / ".ansible" / "cp").glob("*")]:
        try:
            subprocess.run(["ssh", "-F", "/dev/null", "-o", f"ControlPath={sock}", "-O", "exit", "lab"],
                           capture_output=True, timeout=5, check=False)
        except subprocess.TimeoutExpired:
            pass
        sock.unlink(missing_ok=True)


def create_instance(inst, config):
    incus("create", inst.image, inst.name, "--profile", render.PROFILE, *[f"--config={k}={v}" for k, v in config.items()])
    for dev, net in inst.nics.items():
        incus("config", "device", "add", inst.name, dev, "nic", f"network={net}", f"name={dev}")
    for path, (content, mode) in inst.files.items():
        push_file(inst.name, path, content, mode)


def reconfigure_instance(inst, cur, config):
    """Rewires a stopped instance and re-pushes its files. Routers' boot scripts and nodes' networkd config then
    start from a fresh network namespace, so no stale address or route survives."""
    remove, add = nic_changes(cur["devices"], inst.nics)
    for dev in remove:
        incus("config", "device", "remove", inst.name, dev)
    for dev, net in add.items():
        incus("config", "device", "add", inst.name, dev, "nic", f"network={net}", f"name={dev}")
    for path, (content, mode) in inst.files.items():
        push_file(inst.name, path, content, mode)
    if changes := config_changes(cur["config"], config):
        incus("config", "set", inst.name, *[f"{k}={v}" for k, v in changes.items()])


def start_instances(insts):
    """Starts stopped instances and waits until routers have run their boot script and managed hosts answer SSH."""
    if not insts:
        return
    incus("start", *[inst.name for inst in insts])
    for inst in insts:
        if inst.image == render.ROUTER_IMAGE:
            wait_for(
                lambda: run_in(inst.name, "test", "-e", render.READY_FLAG).returncode == 0,
                60,
                f"{inst.name} configuration (see: incus exec {inst.name} -- cat {render.START_LOG})",
            )
    close_ssh_masters()
    for inst in insts:
        if inst.managed:
            wait_for(lambda: ssh_ok(inst.name), 60, f"SSH to {inst.name} (try: ./opsforge ssh {inst.name})")


def cmd_up(args):
    """Creates the lab, or brings an existing one in line with topology.yml: deletes instances and networks no longer
    in it, recreates instances whose image changed, rewires and restarts those whose NICs or files changed, applies
    limit changes live and starts stopped instances. Live link conditions are kept."""
    topo = load_valid_topology()
    missing = [m for m in REQUIRED_MODULES if not Path("/sys/module", m).exists()]
    if missing:
        raise LabError(f"kernel modules not loaded: {', '.join(missing)} (see ./opsforge preflight)")
    networks, instances = lab_plan(topo)
    ensure_images()
    client_pub = write_access(topo, instances)

    if not exists(f"/1.0/profiles/{render.PROFILE}"):
        # Root disk only: lab instances get their NICs explicitly, never incusbr0 from the default profile
        incus("profile", "create", render.PROFILE)
        incus("profile", "device", "add", render.PROFILE, "root", "disk", "path=/", "pool=default")
    for net in networks:
        if not exists(f"/1.0/networks/{net}"):
            # No host address: the host must not route between, or into, lab networks
            incus("network", "create", net, "ipv4.address=none", "ipv6.address=none")

    live = {i["name"]: i for i in lab_instances()}
    changed = sorted(live.keys() - {inst.name for inst in instances})
    for name in changed:
        print(f"  {name}: not in topology.yml, deleting")
        incus("delete", "--force", name)
    # Specs come from topology.yml alone, before wan-core gets live link conditions: `link` edits are not changes
    configs = {inst.name: desired_config(inst) for inst in instances}
    if render.WAN_CORE in live:
        wan_core = next(inst for inst in instances if inst.name == render.WAN_CORE)
        wan_core.files |= render.link_files(merge_link_state(read_link_state(), render.link_state(topo)))

    started = []
    for inst in instances:
        config = configs[inst.name]
        cur = live.get(inst.name)
        if cur and cur["config"].get("volatile.base_image") != image_fingerprint(inst.image):
            print(f"  {inst.name}: image is now {inst.image}, recreating")
            incus("delete", "--force", inst.name)
            cur = None
        if cur is None:
            print(f"  {inst.name}: creating ({inst.role}, {inst.address})")
            if inst.managed:
                inst.files |= render.ssh_files(client_pub, *ssh_keygen(HOST_KEYS / inst.name, inst.name))
            create_instance(inst, config)
        elif cur["config"].get(SPEC_KEY, config[SPEC_KEY]) != config[SPEC_KEY]:
            print(f"  {inst.name}: NICs or config files changed, reconfiguring")
            if cur["status"] != "Stopped":
                incus("stop", inst.name)
            reconfigure_instance(inst, cur, config)
        else:
            # Unchanged (instances from before user.opsforge.spec existed are assumed current and stamped)
            if changes := config_changes(cur["config"], config):
                shown = ", ".join(f"{k}={v}" for k, v in changes.items() if k != SPEC_KEY)
                print(f"  {inst.name}: {f'setting {shown}' if shown else 'recording its spec'}")
                incus("config", "set", inst.name, *[f"{k}={v}" for k, v in changes.items()])
                changed += [inst.name] if shown else []
            if cur["status"] == "Running":
                continue
            print(f"  {inst.name}: {cur['status'].lower()}, starting")
        started.append(inst)
        changed.append(inst.name)
    for net in lab_networks():
        if net not in networks:
            print(f"  deleting network {net}")
            incus("network", "delete", net)

    start_instances(started)
    if not changed:
        print(f"Lab up to date: {len(instances)} instances")
        return 0
    print(f"Lab up: {len(instances)} instances. Next: ./opsforge provision, then ./opsforge verify")
    return 0


def cmd_down(args):
    for fwd in active_forwards():
        stop_forward(fwd)
    for inst in lab_instances():
        print(f"  deleting {inst['name']}")
        incus("delete", "--force", inst["name"])
    for net in lab_networks():
        print(f"  deleting network {net}")
        incus("network", "delete", net)
    if exists(f"/1.0/profiles/{render.PROFILE}"):
        incus("profile", "delete", render.PROFILE)
    for alias in render.IMAGES if args.purge else ():
        if exists(f"/1.0/images/aliases/{alias}"):
            print(f"  deleting image {alias}")
            incus("image", "delete", alias)
    print("Lab down")
    return 0


def stale_images(images, instances):
    """Images built by older opsforge versions: every alias is an `opsforge-*` one no longer in render.IMAGES, and no
    instance was created from it. Unaliased images are Incus' cache of remote base images, which it expires itself."""
    used = {i["config"].get("volatile.base_image") for i in instances}
    return [
        img for img in images
        if img["aliases"]
        and all(a["name"].startswith("opsforge-") and a["name"] not in render.IMAGES for a in img["aliases"])
        and img["fingerprint"] not in used
    ]


def cmd_gc(args):
    images = json.loads(incus("image", "list", "--format", "json").stdout)
    instances = json.loads(incus("list", "--format", "json").stdout)
    stale = stale_images(images, instances)
    for img in stale:
        names = ", ".join(a["name"] for a in img["aliases"])
        print(f"  {'would delete' if args.dry_run else 'deleting'} {names} ({img['size'] / 1024**2:.0f} MiB)")
        if not args.dry_run:
            incus("image", "delete", img["fingerprint"])
    if not stale:
        print("No stale images")
    return 0


def lab_snapshots(insts):
    """{snapshot name: (created_at, [instances that have it])} across the lab's instances."""
    snaps = {}
    for inst in insts:
        for snap in inst.get("snapshots") or ():
            name = snap["name"]
            created, names = snaps.get(name, (snap["created_at"], []))
            snaps[name] = (min(created, snap["created_at"]), [*names, inst["name"]])
    return snaps


def cmd_snapshot(args):
    """Snapshots every lab instance under one name (btrfs: copy-on-write, so near-instant and only changed blocks
    cost space). Taken live: each instance's disk is crash-consistent, as after a power cut."""
    insts = lab_instances()
    if not insts:
        raise LabError("lab is down (./opsforge up)")
    snaps = lab_snapshots(insts)
    if args.list:
        if not snaps:
            print("No snapshots (./opsforge snapshot [NAME])")
        for name, (created, names) in sorted(snaps.items(), key=lambda kv: kv[1][0]):
            missing = "" if len(names) == len(insts) else f", missing on {len(insts) - len(names)} instance(s)"
            print(f"  {name:<24} {created[:19].replace('T', ' ')}  {len(names)} instances{missing}")
        return 0
    if args.delete:
        if not args.name:
            raise LabError("--delete needs a snapshot name")
        if args.name not in snaps:
            raise LabError(f"no snapshot named {args.name!r} (./opsforge snapshot --list)")
        for inst in snaps[args.name][1]:
            incus("snapshot", "delete", inst, args.name)
        print(f"Deleted snapshot {args.name}")
        return 0
    name = args.name or time.strftime("%Y%m%d-%H%M%S")
    if name in snaps:
        raise LabError(f"snapshot {name!r} already exists (./opsforge snapshot --delete {name})")
    for inst in insts:
        incus("snapshot", "create", inst["name"], name)
    used, total = pool_usage()
    print(f"Snapshot {name}: {len(insts)} instances (pool {used / GIB:.2f}/{total / GIB:.0f} GiB). "
          f"Back to it with: ./opsforge restore {name}")
    return 0


def cmd_restore(args):
    """Rolls every lab instance back to a snapshot: disk, config and NICs, so live link conditions too. All instances
    are stopped first and booted together, as after `up`."""
    insts = lab_instances()
    snaps = lab_snapshots(insts)
    if args.name not in snaps:
        raise LabError(f"no snapshot named {args.name!r} (./opsforge snapshot --list)")
    if missing := sorted({i["name"] for i in insts} - set(snaps[args.name][1])):
        raise LabError(f"snapshot {args.name!r} does not cover {', '.join(missing)} (created after it?); "
                       "restoring part of the lab would mix states")
    topo = load_valid_topology()
    planned = {inst.name: inst for inst in lab_plan(topo)[1]}
    for fwd in active_forwards():
        stop_forward(fwd)
    if running := [i["name"] for i in insts if i["status"] != "Stopped"]:
        incus("stop", *running)
    for inst in insts:
        print(f"  {inst['name']}: restoring {args.name}")
        incus("snapshot", "restore", inst["name"], args.name)
    start_instances([planned[i["name"]] for i in insts if i["name"] in planned])
    if rest := [i["name"] for i in insts if i["name"] not in planned]:
        incus("start", *rest)
    drift = sorted(
        i["name"] for i in lab_instances()
        if i["name"] not in planned or i["config"].get(SPEC_KEY) != desired_config(planned[i["name"]])[SPEC_KEY]
    ) + sorted(planned.keys() - {i["name"] for i in insts})
    print(f"Restored {args.name}: {len(insts)} instances")
    if drift:
        print(f"  note: topology.yml differs from the snapshot for {', '.join(drift)}; ./opsforge up applies it")
    return 0


def read_link_state():
    res = incus("file", "pull", f"{render.WAN_CORE}/etc/opsforge/links.json", "-", check=False)
    if res.returncode != 0:
        raise LabError(f"cannot read link state from {render.WAN_CORE} (is the lab up?)")
    return json.loads(res.stdout)


def describe_link(link):
    return " ".join(f"{k}={link[k]}" for k in LINK_KEYS if k in link)


def cmd_status(args):
    insts = lab_instances()
    if not insts:
        print("Lab is down (./opsforge up)")
        return 0
    total = 0
    print(f"{'NAME':<12} {'ROLE':<11} {'SITE':<5} {'STATE':<8} {'MEMORY':>8}  IPV4")
    for inst in sorted(insts, key=lambda i: (i["config"].get("user.opsforge.site", ""), i["name"])):
        state = inst.get("state") or {}
        mem = (state.get("memory") or {}).get("usage", 0) / 1024**2
        total += mem
        ips = [
            f"{a['address']} ({dev})"
            for dev, nic in (state.get("network") or {}).items()
            if dev != "lo"
            for a in nic["addresses"]
            if a["family"] == "inet"
        ]
        cfg = inst["config"]
        print(
            f"{inst['name']:<12} {cfg['user.opsforge.role']:<11} {cfg.get('user.opsforge.site', '-'):<5} "
            f"{inst['status']:<8} {mem:>5.0f} MiB  {', '.join(ips)}"
        )
    print(f"{'total':<39} {total:>5.0f} MiB")
    print(f"\nPool default: {describe_pool(*pool_usage())}")
    print("\nLinks (live)")
    desired = load_valid_topology()["links"]
    for name, link in sorted(read_link_state()["links"].items()):
        drift = "" if link == desired.get(name) else f"  \033[33m(topology.yml: {describe_link(desired.get(name, {}))})\033[0m"
        print(f"  {name:<12} {describe_link(link)}{drift}")
    return 0


def apply_link_state(state):
    for path, (content, mode) in render.link_files(state).items():
        push_file(render.WAN_CORE, path, content, mode)
    res = run_in(render.WAN_CORE, "/etc/opsforge/links.sh")
    if res.returncode != 0:
        raise LabError(f"applying link conditions failed:\n{res.stderr.strip()}")


def save_link(name, link, path=TOPOLOGY):
    """Rewrites one `<name>: { ... }` line of topology.yml in place, keeping its comments and layout."""
    text = path.read_text()
    line = f"  {name}: {{ {', '.join(f'{k}: {link[k]}' for k in LINK_KEYS if k in link)} }}"
    text, n = re.subn(rf"^  {re.escape(name)}:.*$", line, text, count=1, flags=re.M)
    if n != 1:
        raise LabError(f"cannot find link {name} in {path.name}; edit it by hand")
    path.write_text(text)


def cmd_link(args):
    state = read_link_state()
    desired = load_valid_topology()["links"]
    if args.reset and args.link is None:
        state["links"] = {n: dict(link) for n, link in desired.items()}
        apply_link_state(state)
        print("all links reset to topology.yml")
        return 0
    if args.link is None:
        raise LabError("name a link (e.g. a-b), or use --reset alone to reset every link")
    ends = set(args.link.split("-"))
    name = next((n for n in state["links"] if set(n.split("-")) == ends), None)
    if name is None:
        raise LabError(f"no link {args.link}; links: {', '.join(sorted(state['links']))}")
    changes = {k: getattr(args, k) for k in LINK_KEYS if getattr(args, k) is not None}
    if args.reset:
        if changes or args.save:
            raise LabError("--reset cannot be combined with changes or --save")
        state["links"][name] = dict(desired[name])
        apply_link_state(state)
        print(f"{name}: {describe_link(state['links'][name])} (reset to topology.yml)")
        return 0
    if not changes:
        if args.save:
            save_link(name, state["links"][name])
            print(f"{name}: {describe_link(state['links'][name])} (saved to topology.yml)")
        else:
            print(f"{name}: {describe_link(state['links'][name])}")
        return 0
    link = state["links"][name] | changes
    link_schema = json.loads(SCHEMA.read_text())
    link_schema = link_schema["properties"]["links"]["additionalProperties"] | {"$defs": link_schema["$defs"]}
    try:
        jsonschema.validate(link, link_schema)
    except jsonschema.ValidationError as e:
        raise LabError(f"invalid value: {e.message}") from None
    state["links"][name] = link
    apply_link_state(state)
    if args.save:
        save_link(name, link)
        print(f"{name}: {describe_link(link)} (saved to topology.yml)")
    else:
        print(f"{name}: {describe_link(link)} (live only: --save keeps it, --reset reverts to topology.yml)")
    return 0


def check_rtt(r, name, link, src, dst, what):
    """Pings dst from src and checks the average RTT against the link's rtt (±10 %, at least ±3 ms)."""
    out = run_in(src, "ping", "-q", "-c", "20", "-i", "0.2", dst).stdout
    m = re.search(r"= [\d.]+/([\d.]+)/[\d.]+/([\d.]+) ms", out)
    if not m:
        r.fail(f"{name}: {src} cannot ping {what} {dst}")
        return
    avg, mdev = float(m[1]), float(m[2])
    want = render.time_us(link["rtt"]) / 1000
    tol = max(3.0, want * 0.1)
    msg = f"{name}: {src} -> {dst}  rtt {avg:.1f} ms (want {want:.0f} ± {tol:.0f}), mdev {mdev:.1f} ms"
    msg += f" (jitter {link.get('jitter', '0ms')})"
    (r.ok if abs(avg - want) <= tol else r.fail)(msg)


def check_latency(r, topo, links, probe):
    print("Latency (ping from one site to the other site's public IP; jitter is reported as mdev)")
    for name, link in sorted(links.items()):
        a, b = name.split("-")
        check_rtt(r, name, link, probe[b], topo["sites"][a]["public_ip"], f"{a}'s public IP")


def private_targets(topo):
    """One private address per site: its first node's, or the gateway's VPC address if it has none."""
    targets = {s: str(render.gateway_address(site).ip) for s, site in topo["sites"].items()}
    for node, addr in reversed(render.node_addresses(topo).items()):
        targets[topo["nodes"][node]["site"]] = str(addr.ip)
    return targets


def handshake_ages(gateway):
    """{interface: seconds since its latest WireGuard handshake, None if it never had one}."""
    out = run_in(gateway, "wg", "show", "all", "latest-handshakes").stdout
    now = time.time()
    return {dev: (now - int(t) if int(t) else None) for dev, _, t in (line.split("\t") for line in out.splitlines())}


def check_vpn(r, topo, links, probe):
    print(f"VPN (WireGuard mesh: handshake < {VPN_HANDSHAKE_MAX}s, OSPF adjacencies Full; private VPC addresses at "
          "the link's RTT)")
    for site in topo["sites"]:
        gw = render.gateway_name(site)
        ages = handshake_ages(gw)
        for peer, dev, _, _ in render.tunnels(topo, site):
            age = ages.get(dev)
            ok = age is not None and age < VPN_HANDSHAKE_MAX
            (r.ok if ok else r.fail)(
                f"{gw} {dev}: " + ("no such interface" if dev not in ages else
                                   "no handshake yet" if age is None else f"latest handshake {age:.0f}s ago")
            )
    if render.routing(topo) == "ospf":
        for site in topo["sites"]:
            gw = render.gateway_name(site)
            out = run_in(gw, "birdc", "-s", "/run/bird.ctl", "show", "ospf", "neighbors").stdout
            states = {f[4]: f[2] for f in map(str.split, out.splitlines()) if len(f) == 6 and f[4].startswith("wg-")}
            for _, dev, _, _ in render.tunnels(topo, site):
                state = states.get(dev, "no neighbor")
                (r.ok if state.startswith("Full") else r.fail)(f"{gw} {dev}: OSPF {state}")
    targets = private_targets(topo)
    for name, link in sorted(links.items()):
        a, b = name.split("-")
        check_rtt(r, name, link, probe[b], targets[a], f"{a}'s private address")


def check_isolation(r, topo, probe):
    print("Isolation (interconnect: none; private VPC addresses must be unreachable from other sites)")
    targets = private_targets(topo)
    for src_site, src in probe.items():
        for dst_site, ip in targets.items():
            if dst_site == src_site:
                continue
            reached = run_in(src, "ping", "-c", "1", "-W", "2", ip).returncode == 0
            (r.fail if reached else r.ok)(f"{src} -> {ip} (site {dst_site}) {'REACHABLE' if reached else 'blocked'}")


def check_internet(r, topo, probe):
    print("Internet (DNS through wan-core, TCP out through the site gateway)")
    for site, src in probe.items():
        if src == render.gateway_name(site):
            continue
        cmd = "exec 3<>/dev/tcp/deb.debian.org/80"
        ok = run_in(src, "timeout", "10", "bash", "-c", cmd).returncode == 0
        (r.ok if ok else r.fail)(f"{src} reaches deb.debian.org:80")


def check_bandwidth(r, topo, links):
    print("Bandwidth (UDP iperf3 between gateways, offered at 2x the link rate)")
    for name, link in sorted(links.items()):
        if "rate" not in link:
            continue
        a, b = name.split("-")
        server, client = render.gateway_name(a), render.gateway_name(b)
        rate = render.rate_bps(link["rate"])
        run_in(server, "nft", "add rule inet opsforge verify meta l4proto { tcp, udp } th dport 5201 accept")
        try:
            # One retry when iperf3 itself fails: its TCP control connection shares the flooded, lossy link and can
            # time out ("unable to read from stream socket"). A measured rate out of range is never retried.
            for _ in range(2):
                run_in(server, "pkill", "iperf3")
                run_in(server, "iperf3", "-s", "-1", "-D")
                time.sleep(0.5)
                res = run_in(
                    client, "iperf3", "-c", topo["sites"][a]["public_ip"], "-u", "-b", str(2 * rate), "-t", "5", "-J"
                )
                try:
                    got = json.loads(res.stdout)["end"]["sum_received"]["bits_per_second"]
                    break
                except (ValueError, KeyError):
                    got = None
            if got is None:
                r.fail(f"{name}: iperf3 {client} -> {server} failed twice: {res.stdout[-300:]}{res.stderr.strip()}")
                continue
        finally:
            run_in(server, "nft", "flush chain inet opsforge verify")
            run_in(server, "pkill", "iperf3")
        # netem drops `loss` before the rate limiter, so the received rate can sit slightly below it
        msg = f"{name}: {client} -> {server}  {got / 1e6:.1f} Mbit/s received (rate {link['rate']})"
        (r.ok if 0.85 * rate <= got <= 1.05 * rate else r.fail)(msg)


def check_ssh(r, managed):
    print("SSH (from the host, through wan-core and the site gateways)")
    for name in managed:
        (r.ok if ssh_ok(name) else r.fail)(f"ssh {name}")


def provisioned(topo):
    """Any gateway running dnsmasq: a partly provisioned lab then fails the DNS checks instead of skipping them."""
    gateways = map(render.gateway_name, topo["sites"])
    return any(run_in(gw, "rc-service", "-q", "dnsmasq", "status").returncode == 0 for gw in gateways)


def check_dns(r, topo):
    print(f"DNS (every node resolves every lab host as <name>.<site>.{render.LAB_DOMAIN} and by short name)")
    addrs = render.node_addresses(topo)
    want = {render.gateway_name(s): (s, str(render.gateway_address(site).ip)) for s, site in topo["sites"].items()}
    want |= {n: (topo["nodes"][n]["site"], str(addrs[n].ip)) for n in topo["nodes"]}
    names = [f"{n}.{site}.{render.LAB_DOMAIN}" for n, (site, _) in want.items()] + list(want)
    lookup = 'for n in "$@"; do echo "$n $(getent hosts "$n" | cut -d" " -f1)"; done'
    for node in topo["nodes"]:
        out = run_in(node, "sh", "-c", lookup, "sh", *names).stdout
        got = dict(line.split() for line in out.splitlines() if len(line.split()) == 2)
        wrong = [n for n in names if got.get(n) != want[n.split(".")[0]][1]]
        msg = f"{node} resolves {len(names) - len(wrong)}/{len(names)} names"
        (r.fail if wrong else r.ok)(msg + (f", wrong or missing: {', '.join(wrong)}" if wrong else ""))


def check_pki(r, topo):
    print("PKI (node certificates signed by the lab CA)")
    for node in topo["nodes"]:
        res = run_in(node, "openssl", "verify", "-CAfile", "/etc/opsforge/pki/ca.crt", "/etc/opsforge/pki/node.crt")
        (r.ok if res.returncode == 0 else r.fail)(f"{node}: {(res.stdout or res.stderr).strip().splitlines()[-1]}")


def instance_mem_mib(name):
    """Non-reclaimable memory (anon + kernel) from the instance's own cgroup; page cache is left out because
    the kernel reclaims it under pressure, while Incus' usage figure counts it."""
    res = run_in(name, "cat", "/sys/fs/cgroup/memory.stat")
    if res.returncode != 0:
        return None
    stat = dict(line.split() for line in res.stdout.splitlines())
    return (int(stat.get("anon", 0)) + int(stat.get("kernel", 0))) / 1024**2


def check_memory(r, ceiling):
    print(f"Memory (anon + kernel; page cache excluded; lab ceiling {ceiling} MiB)")
    total = 0
    for inst in sorted(i["name"] for i in lab_instances()):
        mib = instance_mem_mib(inst)
        if mib is None:
            r.fail(f"{inst}: cannot read memory.stat")
            continue
        total += mib
        print(f"          {inst:<12} {mib:6.1f} MiB")
    (r.ok if total <= ceiling else r.fail)(f"lab total {total:.0f} MiB (ceiling {ceiling} MiB)")


def check_disk(r, ceiling):
    print(f"Disk (storage pool 'default': images + instances; ceiling {ceiling:g} GiB)")
    used, total = pool_usage()
    (r.ok if used <= ceiling * GIB else r.fail)(f"pool {describe_pool(used, total)} (ceiling {ceiling:g} GiB)")


def cmd_verify(args):
    """Acceptance checks: latency, isolation, internet and bandwidth match topology + live link state (Phase 1);
    SSH access, DNS and PKI once provisioned (Phase 2); with interconnect: vpn, the tunnels (Phase 3)."""
    topo = load_valid_topology()
    links = read_link_state()["links"]
    # One probe host per site: its first node, or the gateway if the site has none
    probe = {s: render.gateway_name(s) for s in topo["sites"]}
    for node, n in reversed(topo["nodes"].items()):
        probe[n["site"]] = node
    r = Report()
    check_latency(r, topo, links, probe)
    if topo.get("interconnect") == "vpn":
        check_vpn(r, topo, links, probe)
    else:
        check_isolation(r, topo, probe)
    check_internet(r, topo, probe)
    if not args.quick:
        check_bandwidth(r, topo, links)
    check_ssh(r, [*map(render.gateway_name, topo["sites"]), *topo["nodes"]])
    if provisioned(topo):
        check_dns(r, topo)
        check_pki(r, topo)
    else:
        print("Provisioning")
        r.warn("gateways run no dnsmasq: lab not provisioned, DNS and PKI checks skipped (./opsforge provision)")
    if args.mem is not None:
        check_memory(r, args.mem)
    if args.disk is not None:
        check_disk(r, args.disk)
    print("\nVerify " + ("\033[31mFAILED\033[0m" if r.failed else "\033[32mpassed\033[0m"))
    return 1 if r.failed else 0


def cmd_render(args):
