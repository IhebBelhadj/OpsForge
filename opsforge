def lab_state():
    """What the lab looks like now, for a mimic panel: instances, live links against topology.yml, faults.
    Never raises: problems go in `error` (and the lab counts as down when Incus cannot be asked)."""
    try:
        topo = load_valid_topology()
    except (LabError, OSError):
        topo = None
    state = {"up": False, "error": None, "topology": TOPOLOGY.name, "layout": None, "sites": {},
             "links": {}, "nodes": [], "fault": False}
    if topo is None:
        state["error"] = f"{TOPOLOGY.name} is invalid: run ./opsforge validate"
        return state
    state["layout"] = scenario.layout(topo)
    state["sites"] = {name: {"public_ip": s["public_ip"], "vpc": s["vpc"]} for name, s in topo["sites"].items()}
    try:
        insts = {i["name"]: i for i in lab_instances()}
    except (OSError, subprocess.SubprocessError) as e:
        state["error"] = f"cannot list Incus instances: {e}"
        insts = {}
    for name, node in topo["nodes"].items():
        inst = insts.get(name)
        state["nodes"].append({"name": name, "site": node["site"], "role": node["role"],
                               "status": inst["status"] if inst else "Missing"})
    for site in topo["sites"]:
        inst = insts.get(f"{site}-gw")
        state["nodes"].append({"name": f"{site}-gw", "site": site, "role": "gateway",
                               "status": inst["status"] if inst else "Missing"})
    core = insts.get("wan-core")
    state["up"] = bool(core) and core["status"] == "Running"
    live = {}
    if state["up"]:
        try:
            live = read_link_state()["links"]
            state["fault"] = read_pre_fault() is not None
        except LabError as e:
            state["error"] = str(e)
    for name, desired in topo["links"].items():
        link = live.get(name, desired)
        condition = "cut" if str(link.get("loss")) == "100%" else "changed" if link != desired else "ok"
        state["links"][name] = {"live": link, "desired": desired, "condition": condition}
    return state


class Problem(Exception):
    """A failed `opsforge academy` command: printed as a problem document (RFC 9457 fields) on stderr."""

    def __init__(self, slug, title, detail):
        super().__init__(detail)
        self.doc = {"contract": academy.CONTRACT, "type": f"/problems/{slug}", "title": title, "detail": detail}


def academy_state():
    """`opsforge academy state`: lab_state() as a contract document."""
    return {"contract": academy.CONTRACT, **lab_state()}


# A step that cannot run ends the run with its message; anything else is a bug and raises
RUN_ERRORS = (LabError, subprocess.CalledProcessError, ValueError)
ACADEMY_LABEL = "app.kubernetes.io/managed-by=opsforge-academy"


def _message(e):
    return str(e).strip() or type(e).__name__


def lab_run(steps, phase, stop=None, namespace=None):
    """Runs scenario steps on the lab: (metrics, log lines, error message or None). `stop(step, metrics)`, called
    after each step, ends the run early when it returns True. With a namespace, setup creates it first and teardown
    deletes it last, even after a failing step (the next attempt starts clean)."""
    try:
        topo = load_valid_topology()
    except (LabError, OSError):
        return {}, [], f"{TOPOLOGY.name} is invalid"
    lines = []

    class Run(ScenarioRun):
        def log(self, _phase, text):
            lines.append(f"{time.monotonic() - self.start:5.1f}s  {text}")

    run, error = Run(topo), None
    try:
        if namespace and phase == "setup":
            lab_namespace(run, phase, namespace, create=True)
        for step in academy.with_namespace(steps or [], namespace):
            run.step(phase, step)
            if stop and stop(step, run.metrics):
                break
    except RUN_ERRORS as e:
        error = _message(e)
    finally:
        run.stop_flap()
    if namespace and phase == "teardown":
        try:
            lab_namespace(run, phase, namespace, create=False)
        except RUN_ERRORS as e:
            error = error or _message(e)
    return run.metrics, lines, error


def lab_namespace(run, phase, namespace, create):
    """Creates (labelled as the Academy's) or deletes `namespace` on every K3s cluster."""
    clusters = render.k3s_clusters(run.topo)
    if not clusters:
        raise LabError(f"namespace {namespace} needs a K3s cluster")
    for c in clusters.values():
        run.log(phase, f"{'create' if create else 'delete'} namespace {namespace} on {c['server']}")
        if create:
            cmd = (f"k3s kubectl get namespace {namespace} >/dev/null 2>&1 || k3s kubectl create namespace {namespace}"
                   f" && k3s kubectl label --overwrite namespace {namespace} {ACADEMY_LABEL}")
        else:
            cmd = f"k3s kubectl delete namespace {namespace} --ignore-not-found --timeout=120s"
        res = run_in(c["server"], "sh", "-c", cmd)
        if res.returncode:
            raise LabError(f"namespace {namespace} on {c['server']}: {(res.stderr or res.stdout).strip()}")


def lab_probe(arg, namespace=None):
    """Runs a probe check. It stops at the first named step whose expectations fail, so a check on an unchanged
    lab answers at once instead of sitting through every later wait_until."""
    expectations = scenario.expectations(arg)

    def failed(step, metrics):
        mine = [(m, c) for m, c in expectations if m.split(".")[0] == step.get("name")]
        return any(not scenario.check(m, c, metrics)[0] for m, c in mine)

    metrics, lines, error = lab_run(arg["steps"], "check", stop=failed, namespace=namespace)
    results = []
    for metric, condition in expectations:
        ok, value, _ = scenario.check(metric, condition, metrics)
        checked = value is not None or metric.split(".")[0] in {k.split(".")[0] for k in metrics}
        results.append({"metric": metric, "want": condition, "got": value, "passed": ok, "checked": checked})
    return {"passed": error is None and all(r["passed"] for r in results), "results": results, "log": lines,
            "error": error}


def academy_input(kind):
    """The command's input document from stdin, checked against toolchain.schema.json."""
    try:
        doc = json.load(sys.stdin)
    except json.JSONDecodeError as e:
        raise Problem("bad-input", "Bad input", f"stdin is not one JSON document: {e}") from None
    if isinstance(doc, dict) and doc.get("contract") != academy.CONTRACT:
        raise Problem("contract-mismatch", "Contract mismatch",
                      f"input is contract {doc.get('contract')}, this toolchain speaks {academy.CONTRACT}")
    if errs := academy.input_errors(kind, doc):
        raise Problem("bad-input", "Bad input", "; ".join(errs))
    return doc


def academy_run(doc):
    """`opsforge academy run`: a lab's setup or teardown steps."""
    metrics, lines, error = lab_run(doc["steps"], doc["phase"], namespace=doc.get("namespace"))
    return {"contract": academy.CONTRACT, "metrics": metrics, "log": lines, "error": error}


def academy_probe(doc):
    """`opsforge academy probe`: a probe check (passed, one result per expectation)."""
    return {"contract": academy.CONTRACT, **lab_probe(doc, namespace=doc.get("namespace"))}


def academy_heal():
    """`opsforge academy heal`: every link back to its state from before the first fault."""
    return {"contract": academy.CONTRACT, "healed": heal_links()}


def academy_compile(paths):
    for path in paths:
        if not (path / "pack.yml").is_file():
            raise Problem("not-a-pack", "Not a pack", f"{path}: no pack.yml (a pack is a folder like labs/core)")
    # SOURCE_DATE_EPOCH (reproducible builds) pins the timestamp, so the same packs compile to the same bytes
    epoch = os.environ.get("SOURCE_DATE_EPOCH")
    stamp = time.gmtime(int(epoch)) if epoch else time.gmtime()
    return academy.compile_bundle(paths, ROOT, time.strftime("%Y-%m-%dT%H:%M:%SZ", stamp))


def cmd_academy(args):
    """The JSON contract the Academy platform (academy/, Go) calls: one document on stdout, exit 0; a problem
    document on stderr and exit 1 otherwise (docs/courses/architecture.md, "The lab toolchain contract")."""
    try:
        if args.action == "compile":
            doc = academy_compile([p.resolve() for p in args.packs] or labs.find_packs(LABS))
        elif args.action == "state":
            doc = academy_state()
        elif args.action == "run":
            doc = academy_run(academy_input("runInput"))
        elif args.action == "probe":
            doc = academy_probe(academy_input("probeInput"))
        elif args.action == "heal":
            doc = academy_heal()
        else:
            doc = {"contract": academy.CONTRACT}
    except Problem as e:
        problem = e.doc
    except LabError as e:
        problem = Problem("lab-error", "Lab error", str(e)).doc
    else:
        problem = None
    if problem:
        print(json.dumps(problem) if args.json else f"opsforge academy {args.action}: {problem['detail']}",
              file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(doc, sort_keys=True))
        return 0
    if args.action == "compile":
        packs = doc["packs"]
        count = {k: sum(len(p[k]) for p in packs) for k in ("courses", "labs")}
        print(f"{len(packs)} pack(s), {count['courses']} course(s), {count['labs']} lab(s): "
              + ("no errors" if not doc["errors"] else f"{len(doc['errors'])} error(s)"))
        for e in doc["errors"]:
            print(f"  {e['pack']}: {e['message']}")
        return 1 if doc["errors"] else 0
    if args.action in ("run", "probe"):
        print("\n".join(doc["log"]))
        if "passed" in doc:
            for r in doc["results"]:
                print(f"{'PASS' if r['passed'] else 'FAIL'}  {r['metric']} {r['want']} (got {r['got']})")
        if doc["error"]:
            print(f"error: {doc['error']}", file=sys.stderr)
        return 0 if doc.get("passed", True) and not doc["error"] else 1
    if args.action == "heal":
        print("healed" if doc["healed"] else "no fault to heal")
        return 0
    if args.action == "state":
        print(f"{doc['topology']} ({doc['layout']}): lab {'up' if doc['up'] else 'down'}"
              + (", fault active" if doc["fault"] else "") + (f" ({doc['error']})" if doc["error"] else ""))
        return 0
    print(f"contract {doc['contract']}")
    return 0


def cmd_serve(args):
    """The teaching-lab web interface on 127.0.0.1 (lab/labserver.py); imports the packs first."""
    import labserver

    conn = labsdb.connect(LABS_DB)
    import_packs(conn)
    conn.close()
    labserver.serve(sys.modules[__name__], args.port, LABS_DB, ROOT, WEB)
    return 0


def main():
    parser = argparse.ArgumentParser(prog="opsforge", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("validate", help="validate topology.yml")
    p.add_argument("topology", nargs="?", default=TOPOLOGY, type=Path)
    p.set_defaults(func=cmd_validate)
    sub.add_parser("preflight", help="check the host is ready to run the lab").set_defaults(func=cmd_preflight)
    sub.add_parser("smoke", help="launch a throwaway container to prove Incus networking works").set_defaults(
        func=cmd_smoke
    )
    sub.add_parser("up", help="create the lab, or apply topology.yml edits to it").set_defaults(func=cmd_up)
    p = sub.add_parser("down", help="destroy the lab")
    p.add_argument("--purge", action="store_true", help=f"also delete the cached {', '.join(render.IMAGES)} images")
    p.set_defaults(func=cmd_down)
    p = sub.add_parser("gc", help="delete images built by older opsforge versions (old opsforge-* aliases)")
    p.add_argument("--dry-run", action="store_true", help="only list what would be deleted")
    p.set_defaults(func=cmd_gc)
    p = sub.add_parser("snapshot", help="snapshot every lab instance under one name, e.g. after provision")
    p.add_argument("name", nargs="?", help="snapshot name (default: the current time, YYYYmmdd-HHMMSS)")
    p.add_argument("--list", action="store_true", help="list the lab's snapshots")
    p.add_argument("--delete", action="store_true", help="delete the named snapshot from every instance")
    p.set_defaults(func=cmd_snapshot)
    p = sub.add_parser("restore", help="roll the whole lab back to a snapshot (restarts every instance)")
    p.add_argument("name")
    p.set_defaults(func=cmd_restore)
    sub.add_parser("status", help="show instances, memory and live link conditions").set_defaults(func=cmd_status)
    p = sub.add_parser("link", help="show or change a WAN link's conditions live, e.g. link a-b --rtt 200ms")
    p.add_argument("link", nargs="?", help="site pair, e.g. a-b (omit with --reset to reset every link)")
    p.add_argument("--rtt", help="round-trip time, e.g. 80ms")
    p.add_argument("--jitter", help="RTT standard deviation, e.g. 10ms (0ms disables)")
    p.add_argument("--loss", help="per-direction packet loss, e.g. 0.5%% (0%% disables)")
    p.add_argument("--rate", help="per-direction bandwidth, e.g. 20mbit")
    p.add_argument("--mtu", type=int, help="drop packets longer than this, silently (path-MTU black hole; 0 removes)")
    p.add_argument("--save", action="store_true", help="also write the link's conditions to topology.yml")
    p.add_argument("--reset", action="store_true", help="revert the link (or every link) to topology.yml")
    p.set_defaults(func=cmd_link)
    p = sub.add_parser("verify", help="check the WAN, VPN, provisioning and K3s against topology and live links")
    p.add_argument("--quick", action="store_true", help="skip the bandwidth test")
    p.add_argument(
        "--mem", nargs="?", type=int, const=0, metavar="MIB",
        help="also fail if the lab's non-reclaimable memory exceeds MIB (default per layout: "
        + ", ".join(f"{k} {v}" for k, v in MEM_CEILING_MIB.items()) + ")",
    )
    p.add_argument(
        "--disk", nargs="?", type=float, const=0, metavar="GIB",
        help="also fail if the storage pool's used space exceeds GIB (default per layout: "
        + ", ".join(f"{k} {v}" for k, v in DISK_CEILING_GIB.items()) + ")",
    )
    p.set_defaults(func=cmd_verify)
    sub.add_parser("render", help="print the generated networks, instances and config files").set_defaults(
        func=cmd_render
    )
    p = sub.add_parser("provision", help="configure the lab with Ansible (ansible/site.yml) over SSH")
    p.add_argument("ansible_args", nargs=argparse.REMAINDER, help="passed to ansible-playbook, e.g. --check --diff")
    p.set_defaults(func=cmd_provision)
    p = sub.add_parser("ssh", help="ssh to a lab host through wan-core and its site gateway, e.g. ssh b-w1")
    p.add_argument("host")
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_ssh)
    p = sub.add_parser("forward", help="tunnel a lab service to 127.0.0.1 on the host, e.g. forward a-cp1:6443")
    p.add_argument("target", nargs="?", help="<host>:<port> (with --stop: only that forward)")
    p.add_argument("--local", type=int, help="local port (default: the same port, +10000 below 1024)")
    p.add_argument("--to", default="127.0.0.1", help="address the lab host connects to (default its own 127.0.0.1)")
    p.add_argument("--list", action="store_true", help="list running forwards")
    p.add_argument("--stop", action="store_true", help="stop the forward to <host>:<port>, or every forward")
    p.set_defaults(func=cmd_forward)
    p = sub.add_parser(
        "capture", help="tcpdump inside a lab instance into a pcap on the host, e.g. capture wan-core udp port 51820"
    )
    p.add_argument("instance", help="lab instance, e.g. wan-core, a-gw, b-w1")
    p.add_argument("filter", nargs="*", help="tcpdump (BPF) filter, e.g. icmp or 'udp port 53'")
    p.add_argument("-i", "--iface", default="any", help="interface (default any)")
    p.add_argument("-d", "--duration", type=int, default=10, help="seconds to capture, 0 = until Ctrl-C (default 10)")
    p.add_argument("-c", "--count", type=int, help="stop after this many packets")
    p.add_argument("-o", "--output", type=Path, help=f"pcap path (default {CAPTURES.relative_to(ROOT)}/<instance>-<time>.pcap)")
    p.add_argument("--show", nargs="?", const="brief", choices=("brief", "full"),
                   help="also print the packets (decoded by the instance's tcpdump)")
    p.set_defaults(func=cmd_capture)
    p = sub.add_parser("kubectl", help="kubectl against a lab cluster from the host, e.g. kubectl get nodes")
    p.add_argument("--cluster", help="K3s cluster (default: the first in the topology); before kubectl's arguments")
    p.add_argument("kubectl_args", nargs=argparse.REMAINDER, help="passed to kubectl")
    p.set_defaults(func=cmd_kubectl)
    p = sub.add_parser("partition", help="cut a site off the other sites (100 %% loss on its links)")
    p.add_argument("site")
    p.set_defaults(func=cmd_partition)
    p = sub.add_parser("degrade", help="change a link until heal, e.g. degrade a-c --rtt 300ms --loss 2%%")
    p.add_argument("link")
    for key, help_ in (("rtt", "round-trip time"), ("jitter", "RTT standard deviation"), ("loss", "per-direction loss"),
                       ("rate", "per-direction bandwidth")):
        p.add_argument(f"--{key}", help=help_)
    p.add_argument("--mtu", type=int, help="drop packets longer than this, silently")
    p.set_defaults(func=cmd_degrade)
    p = sub.add_parser("mtu", help="path-MTU black hole until heal: drop packets over BYTES between two sites")
    p.add_argument("link")
    p.add_argument("bytes", type=int)
    p.set_defaults(func=cmd_mtu)
    p = sub.add_parser("flap", help="take a link down and up repeatedly (foreground), e.g. flap a-b --period 10s")
    p.add_argument("link")
    p.add_argument("--period", default="10s", help="full down+up cycle (default 10s, at least 2s)")
    p.add_argument("--duration", help="stop after this long, e.g. 60s (default: until Ctrl-C)")
    p.set_defaults(func=cmd_flap)
    sub.add_parser("heal", help="undo every partition/degrade/mtu/flap: links back to their pre-fault state").set_defaults(
        func=cmd_heal
    )
    p = sub.add_parser("scenario", help="run a scripted experiment from scenarios/ and check its expectations")
    p.add_argument("name", nargs="?", help="scenario (omit, or --list, to list them)")
    p.add_argument("--list", action="store_true", help="list the scenarios")
    p.set_defaults(func=cmd_scenario)
    p = sub.add_parser("labs", help="teaching-lab packs in labs/: validate, import into the database, list progress")
    p.add_argument("action", nargs="?", default="list", choices=("list", "import", "validate"))
    p.set_defaults(func=cmd_labs)
    p = sub.add_parser("serve", help="the teaching-lab web interface on 127.0.0.1 (browser terminal included)")
    p.add_argument("--port", type=int, default=LABS_PORT, help=f"port (default {LABS_PORT})")
    p.set_defaults(func=cmd_serve)
    p = sub.add_parser("academy", help="the Academy platform's lab toolchain: compile course packs, lab state, run "
                       "and probe steps (JSON)")
    p.add_argument("action", choices=("compile", "state", "run", "probe", "heal", "version"),
                   help="run and probe read their input document on stdin")
    p.add_argument("packs", nargs="*", type=Path, help="compile: pack folders (default: every pack in labs/)")
    p.add_argument("--json", action="store_true", help="print the contract document (what academy reads)")
    p.set_defaults(func=cmd_academy)
    # argparse.REMAINDER drops leading options (`provision --check`, `kubectl -n demo get pods`), so these two take
    # the unknown ones
    args, extra = parser.parse_known_args()
    if extra and args.command not in ("provision", "kubectl"):
        parser.error(f"unrecognized arguments: {' '.join(extra)}")
    if args.command == "provision":
        args.ansible_args = extra + args.ansible_args
    if args.command == "kubectl":
        args.kubectl_args = extra + args.kubectl_args
    try:
        return args.func(args)
    except LabError as e:
        print(f"opsforge {args.command}: {e}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as e:
        print(f"opsforge {args.command}: '{' '.join(e.cmd)}' failed:\n{(e.stderr or '').strip()}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
