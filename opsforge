def read_pre_fault():
    res = incus("file", "pull", f"{render.WAN_CORE}{PRE_FAULT}", "-", check=False)
    return json.loads(res.stdout) if res.returncode == 0 else None


def begin_fault(state):
    """Saves the live link state before the first fault (later faults stack on top), for `heal`."""
    if read_pre_fault() is None:
        push_file(render.WAN_CORE, PRE_FAULT, json.dumps(state, indent=2) + "\n", "0644")


def heal_links():
    """Every link back to its live state from before the first fault; False if there was no fault."""
    pre = read_pre_fault()
    if pre is None:
        return False
    state = read_link_state()
    state["links"] = {name: pre["links"].get(name, link) for name, link in state["links"].items()}
    apply_link_state(state)
    run_in(render.WAN_CORE, "rm", "-f", PRE_FAULT)
    return True


def cmd_partition(args):
    """Cuts a site off the other sites (100 % loss on each of its links). The site keeps its internet access and the
    host's management path."""
    topo = load_valid_topology()
    if args.site not in topo["sites"]:
        raise LabError(f"no site {args.site}; sites: {', '.join(topo['sites'])}")
    state = read_link_state()
    begin_fault(state)
    cut = sorted(n for n in state["links"] if args.site in n.split("-"))
    for name in cut:
        state["links"][name] = state["links"][name] | {"loss": "100%"}
    apply_link_state(state)
    print(f"site {args.site} partitioned: {', '.join(cut)} at 100 % loss (./opsforge heal restores them)")
    return 0


def degrade_link(spec, changes):
    state = read_link_state()
    name = find_link(state, spec)
    link = edit_link(state["links"][name], changes)
    begin_fault(state)
    state["links"][name] = link
    apply_link_state(state)
    return name, link


def cmd_degrade(args):
    """A link change that `heal` undoes (`link` changes are kept until `link --reset`)."""
    changes = {k: getattr(args, k) for k in LINK_KEYS if getattr(args, k) is not None}
    if not changes:
        raise LabError("nothing to change: give --rtt, --jitter, --loss, --rate or --mtu")
    name, link = degrade_link(args.link, changes)
    print(f"{name} degraded: {describe_link(link)} (./opsforge heal restores it)")
    return 0


def cmd_mtu(args):
    """Path-MTU black hole between two sites: packets longer than BYTES vanish, no ICMP tells the sender."""
    name, _ = degrade_link(args.link, {"mtu": args.bytes})
    print(f"{name}: packets over {args.bytes} bytes dropped silently (./opsforge heal restores it)")
    return 0


def flap_link(spec, period, duration=None, stop=None):
    """Takes a link down (100 % loss) and up again every period/2 seconds until `duration` has passed or `stop` (a
    threading.Event) is set, then restores it. A killed flap leaves the pre-fault state for `heal`."""
    state = read_link_state()
    name = find_link(state, spec)
    begin_fault(state)
    base = dict(state["links"][name])
    end = time.monotonic() + duration if duration else None
    down = False
    try:
        while not (stop and stop.is_set()) and (end is None or time.monotonic() < end):
            down = not down
            state = read_link_state()
            state["links"][name] = base | {"loss": "100%"} if down else base
            apply_link_state(state)
            if stop:
                stop.wait(period / 2)
            else:
                time.sleep(period / 2)
    finally:
        state = read_link_state()
        state["links"][name] = base
        apply_link_state(state)
        if read_pre_fault() == state:
            # This flap was the only fault: nothing left for heal to do
            run_in(render.WAN_CORE, "rm", "-f", PRE_FAULT)
    return name


def cmd_flap(args):
    period = render.time_us(args.period) / 1e6
    if period < 2:
        raise LabError("--period must be at least 2s (each change takes a fraction of a second)")
    duration = render.time_us(args.duration) / 1e6 if args.duration else None
    print(f"flapping {args.link}: down/up every {period / 2:g}s "
          f"{'for ' + args.duration if duration else 'until Ctrl-C'}", file=sys.stderr)
    try:
        name = flap_link(args.link, period, duration)
    except KeyboardInterrupt:
        name = args.link
    print(f"{name}: flapping stopped, link restored")
    return 0


def cmd_heal(args):
    """Restores every link to its live state from before the first fault (not to topology.yml)."""
    print("healed: links back to their pre-fault state" if heal_links() else "nothing to heal (no fault in place)")
    return 0


class ScenarioRun:
    """Runs scenario steps against the lab (lab/scenario.py describes the file format) and collects metrics."""

    def __init__(self, topo):
        self.topo = topo
        self.metrics = {}
        self.flapping = None  # (thread, stop event) of a background `flap` step
        self.start = time.monotonic()

    def log(self, phase, text):
        print(f"  {time.monotonic() - self.start:6.1f}s  [{phase}] {text}")

    def target(self, name):
        """A lab host's name -> its private address (a gateway's VPC address); anything else unchanged."""
        if name in render.node_addresses(self.topo) or name.endswith("-gw"):
            return scenario.substitute(f"${{ip:{name}}}", self.topo)
        return scenario.substitute(str(name), self.topo)

    def shell(self, on, cmd, timeout):
        """(exit code, stdout) of a shell command on the host (from the repo root, so ./opsforge works) or in an
        instance."""
        cmd = scenario.substitute(cmd, self.topo)
        if on == "host":
            try:
                res = subprocess.run(["bash", "-c", cmd], cwd=ROOT, stdin=subprocess.DEVNULL, capture_output=True,
                                     text=True, timeout=timeout)
            except subprocess.TimeoutExpired:
                return 124, ""
        else:
            res = run_in(on, "timeout", str(int(timeout)), "sh", "-c", cmd)
        return res.returncode, res.stdout

    def promql(self, query):
        mon = render.monitoring_node(self.topo)
        if mon is None:
            raise LabError("promql steps need a monitoring node")
        data = vm_query(mon, "/api/v1/query", query=query)
        return float(data["result"][0]["value"][1]) if data and data["result"] else None

    def step(self, phase, step):
        kind = scenario.step_type(step)
        arg = step[kind]
        name = step.get("name")
        shown = arg if not isinstance(arg, dict) else " ".join(f"{k}={v}" for k, v in arg.items())
        self.log(phase, f"{kind} {scenario.substitute(str(shown), self.topo)}" + (f"  -> {name}" if name else ""))
        got = {}
        if kind == "sleep":
            time.sleep(scenario.seconds(arg))
        elif kind == "partition":
            cmd_partition(argparse.Namespace(site=str(arg)))
        elif kind == "heal":
            heal_links()
        elif kind in ("degrade", "mtu"):
            changes = {"mtu": arg["bytes"]} if kind == "mtu" else {k: arg[k] for k in LINK_KEYS if k in arg}
            degrade_link(arg["link"], changes)
        elif kind == "flap":
            stop = threading.Event()
            period = scenario.seconds(arg.get("period", "10s"))
            thread = threading.Thread(target=flap_link, args=(arg["link"], period), kwargs={"stop": stop}, daemon=True)
            thread.start()
            self.flapping = (thread, stop)
        elif kind == "stop_flap":
            self.stop_flap()
        elif kind == "run":
            began = time.monotonic()
            code, out = self.shell(arg.get("host", "host"), arg["cmd"], scenario.seconds(arg.get("timeout", 300)))
            got = {"exit": code, "seconds": time.monotonic() - began}
            last = out.strip().splitlines()[-1] if out.strip() else ""
            if re.fullmatch(r"-?\d+(\.\d+)?", last):
                got["value"] = float(last)
        elif kind == "ping":
            count, interval = int(arg.get("count", 20)), arg.get("interval", 0.2)
            out = run_in(arg["from"], "ping", "-q", "-c", str(count), "-i", str(interval), self.target(arg["to"])).stdout
            got = scenario.parse_ping(out)
        elif kind == "http":
            count, timeout = int(arg.get("count", 10)), scenario.seconds(arg.get("timeout", 10))
            url = scenario.substitute(arg["url"], self.topo)
            loop = (f"for i in $(seq {count}); do curl -s -o /dev/null -m {timeout:g} "
                    f"-w '%{{http_code}} %{{time_total}}\\n' '{url}'; done")
            got = scenario.parse_http(run_in(arg["from"], "sh", "-c", loop).stdout)
        elif kind == "transfer":
            timeout = scenario.seconds(arg.get("timeout", 30))
            res = run_in(arg["from"], "curl", "-s", "-o", "/dev/null", "-m", f"{timeout:g}", "-w",
                         "%{http_code} %{size_download} %{time_total}", scenario.substitute(arg["url"], self.topo))
            got = scenario.parse_transfer(res.stdout, res.returncode)
        elif kind == "wait_until":
            timeout, interval = scenario.seconds(arg.get("timeout", 300)), scenario.seconds(arg.get("interval", 2))
            began, ok = time.monotonic(), False
            while not ok and time.monotonic() - began < timeout:
                if "promql" in arg:
                    value = self.promql(arg["promql"])
                    ok = value is not None and scenario.check("v", arg["until"], {"v": value})[0]
                else:
                    ok = self.shell(arg.get("host", "host"), arg["cmd"], min(timeout, 60))[0] == 0
                if not ok:
                    time.sleep(interval)
            got = {"ok": int(ok), "seconds": time.monotonic() - began}
        elif kind == "promql":
            value = self.promql(arg["query"])
            got = {} if value is None else {"value": value}
        if name:
            self.metrics |= {f"{name}.{k}": v for k, v in got.items()}
            if got:
                self.log(phase, "    " + ", ".join(f"{k}={v:.4g}" for k, v in got.items()))

    def stop_flap(self):
        if self.flapping:
            thread, stop = self.flapping
            stop.set()
            thread.join()
            self.flapping = None


def cmd_scenario(args):
    """Runs a scripted experiment (scenarios/<name>.yml) and checks its expectations; the links are always healed."""
    files = {f.stem: f for f in sorted(SCENARIOS.glob("*.yml"))}
    if args.list or not args.name:
        for name, path in files.items():
            doc = yaml.safe_load(path.read_text())
            print(f"{name:<24} {' '.join(str(doc.get('description', '')).split())}")
        return 0
    if args.name not in files:
        raise LabError(f"no scenario {args.name}; scenarios: {', '.join(files)}")
    doc = yaml.safe_load(files[args.name].read_text())
    if errs := scenario.errors(doc):
        raise LabError(f"{files[args.name].relative_to(ROOT)}: " + "; ".join(errs))
    topo = load_valid_topology()
    if read_pre_fault() is not None:
        raise LabError("a fault is in place (./opsforge heal first): the scenario would heal it")
    print(f"Scenario {args.name}: {' '.join(str(doc['description']).split())}")
    run = ScenarioRun(topo)
    error = None
    try:
        for phase in ("setup", "fault", "measure"):
            for step in doc.get(phase) or []:
                run.step(phase, step)
    except (LabError, subprocess.CalledProcessError, KeyboardInterrupt) as e:
        error = f"{type(e).__name__}: {e}"
        print(f"  step failed: {error}")
    finally:
        run.stop_flap()
        heal_links()
        for step in doc.get("teardown") or []:
            try:
                run.step("teardown", step)
            except (LabError, subprocess.CalledProcessError) as e:
                print(f"  teardown step failed: {e}")
    print("Expectations")
    results, passed = [], error is None
    for metric, condition in scenario.expectations(doc):
        ok, value, threshold = scenario.check(metric, condition, run.metrics)
        passed &= ok
        shown = "missing" if value is None else f"{value:.4g}"
        bound = "" if threshold is None or re.fullmatch(r"[<>=!]+\s*[\d.]+", str(condition)) else f" (= {threshold:.4g})"
        verdict = "\033[32mPASS\033[0m" if ok else "\033[31mFAIL\033[0m"
        print(f"  {verdict}  {metric} = {shown}, want {condition}{bound}")
        results.append({"metric": metric, "condition": str(condition), "value": value, "passed": ok})
    RESULTS.mkdir(parents=True, exist_ok=True)
    previous = sorted(RESULTS.glob(f"{args.name}-*.json"))
    out = RESULTS / f"{args.name}-{time.strftime('%Y%m%d-%H%M%S')}.json"
    out.write_text(json.dumps({
        "scenario": args.name, "finished": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "passed": passed, "error": error,
        "seconds": round(time.monotonic() - run.start, 1), "metrics": run.metrics, "expectations": results,
    }, indent=2) + "\n")
    if previous and (moved := scenario.compare(json.loads(previous[-1].read_text())["metrics"], run.metrics)):
        print(f"Since the last run ({previous[-1].name})")
        for line in moved:
            print(f"  {line}")
    print(f"\nScenario {args.name} " + ("\033[32mpassed\033[0m" if passed else "\033[31mFAILED\033[0m")
          + f" ({out.relative_to(ROOT)})")
    return 0 if passed else 1


def cmd_provision(args):
    """Runs ansible/site.yml against the lab over SSH, with a freshly rendered inventory."""
    topo = load_valid_topology()
    if not lab_instances():
        raise LabError("lab is down (./opsforge up)")
    write_access(topo, lab_plan(topo)[1])
    return subprocess.run(["ansible-playbook", "site.yml", *args.ansible_args], cwd=ANSIBLE_DIR).returncode


def main():
    parser = argparse.ArgumentParser(prog="opsforge", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("validate", help="validate topology.yml")
    p.add_argument("topology", nargs="?", default=TOPOLOGY, type=Path)
    p.set_defaults(func=cmd_validate)
    sub.add_parser("preflight", help="check the host is ready to run the lab").set_defaults(func=cmd_preflight)
    sub.add_parser("smoke", help="launch a throwaway container to prove Incus networking works").set_defaults(
        func=cmd_smoke
    )
    sub.add_parser("up", help="create the lab, or apply topology.yml edits to it").set_defaults(func=cmd_up)
    p = sub.add_parser("down", help="destroy the lab")
    p.add_argument("--purge", action="store_true", help=f"also delete the cached {', '.join(render.IMAGES)} images")
    p.set_defaults(func=cmd_down)
    p = sub.add_parser("gc", help="delete images built by older opsforge versions (old opsforge-* aliases)")
    p.add_argument("--dry-run", action="store_true", help="only list what would be deleted")
    p.set_defaults(func=cmd_gc)
    p = sub.add_parser("snapshot", help="snapshot every lab instance under one name, e.g. after provision")
    p.add_argument("name", nargs="?", help="snapshot name (default: the current time, YYYYmmdd-HHMMSS)")
    p.add_argument("--list", action="store_true", help="list the lab's snapshots")
    p.add_argument("--delete", action="store_true", help="delete the named snapshot from every instance")
    p.set_defaults(func=cmd_snapshot)
    p = sub.add_parser("restore", help="roll the whole lab back to a snapshot (restarts every instance)")
    p.add_argument("name")
    p.set_defaults(func=cmd_restore)
    sub.add_parser("status", help="show instances, memory and live link conditions").set_defaults(func=cmd_status)
    p = sub.add_parser("link", help="show or change a WAN link's conditions live, e.g. link a-b --rtt 200ms")
    p.add_argument("link", nargs="?", help="site pair, e.g. a-b (omit with --reset to reset every link)")
    p.add_argument("--rtt", help="round-trip time, e.g. 80ms")
    p.add_argument("--jitter", help="RTT standard deviation, e.g. 10ms (0ms disables)")
    p.add_argument("--loss", help="per-direction packet loss, e.g. 0.5%% (0%% disables)")
    p.add_argument("--rate", help="per-direction bandwidth, e.g. 20mbit")
    p.add_argument("--mtu", type=int, help="drop packets longer than this, silently (path-MTU black hole; 0 removes)")
    p.add_argument("--save", action="store_true", help="also write the link's conditions to topology.yml")
    p.add_argument("--reset", action="store_true", help="revert the link (or every link) to topology.yml")
    p.set_defaults(func=cmd_link)
    p = sub.add_parser("verify", help="check the WAN, VPN, provisioning and K3s against topology and live links")
    p.add_argument("--quick", action="store_true", help="skip the bandwidth test")
    p.add_argument(
        "--mem", nargs="?", type=int, const=MEM_CEILING_MIB, metavar="MIB",
        help=f"also fail if the lab's non-reclaimable memory exceeds MIB (default {MEM_CEILING_MIB})",
    )
    p.add_argument(
        "--disk", nargs="?", type=float, const=DISK_CEILING_GIB, metavar="GIB",
        help=f"also fail if the storage pool's used space exceeds GIB (default {DISK_CEILING_GIB})",
    )
    p.set_defaults(func=cmd_verify)
    sub.add_parser("render", help="print the generated networks, instances and config files").set_defaults(
        func=cmd_render
    )
    p = sub.add_parser("provision", help="configure the lab with Ansible (ansible/site.yml) over SSH")
    p.add_argument("ansible_args", nargs=argparse.REMAINDER, help="passed to ansible-playbook, e.g. --check --diff")
    p.set_defaults(func=cmd_provision)
    p = sub.add_parser("ssh", help="ssh to a lab host through wan-core and its site gateway, e.g. ssh b-w1")
    p.add_argument("host")
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_ssh)
    p = sub.add_parser("forward", help="tunnel a lab service to 127.0.0.1 on the host, e.g. forward a-cp1:6443")
    p.add_argument("target", nargs="?", help="<host>:<port> (with --stop: only that forward)")
    p.add_argument("--local", type=int, help="local port (default: the same port, +10000 below 1024)")
    p.add_argument("--to", default="127.0.0.1", help="address the lab host connects to (default its own 127.0.0.1)")
    p.add_argument("--list", action="store_true", help="list running forwards")
    p.add_argument("--stop", action="store_true", help="stop the forward to <host>:<port>, or every forward")
    p.set_defaults(func=cmd_forward)
    p = sub.add_parser(
        "capture", help="tcpdump inside a lab instance into a pcap on the host, e.g. capture wan-core udp port 51820"
    )
    p.add_argument("instance", help="lab instance, e.g. wan-core, a-gw, b-w1")
    p.add_argument("filter", nargs="*", help="tcpdump (BPF) filter, e.g. icmp or 'udp port 53'")
    p.add_argument("-i", "--iface", default="any", help="interface (default any)")
    p.add_argument("-d", "--duration", type=int, default=10, help="seconds to capture, 0 = until Ctrl-C (default 10)")
    p.add_argument("-c", "--count", type=int, help="stop after this many packets")
    p.add_argument("-o", "--output", type=Path, help=f"pcap path (default {CAPTURES.relative_to(ROOT)}/<instance>-<time>.pcap)")
    p.add_argument("--show", nargs="?", const="brief", choices=("brief", "full"),
                   help="also print the packets (decoded by the instance's tcpdump)")
    p.set_defaults(func=cmd_capture)
    p = sub.add_parser("kubectl", help="kubectl against the lab cluster from the host, e.g. kubectl get nodes")
    p.add_argument("kubectl_args", nargs=argparse.REMAINDER, help="passed to kubectl")
    p.set_defaults(func=cmd_kubectl)
    p = sub.add_parser("partition", help="cut a site off the other sites (100 %% loss on its links)")
    p.add_argument("site")
    p.set_defaults(func=cmd_partition)
    p = sub.add_parser("degrade", help="change a link until heal, e.g. degrade a-c --rtt 300ms --loss 2%%")
    p.add_argument("link")
    for key, help_ in (("rtt", "round-trip time"), ("jitter", "RTT standard deviation"), ("loss", "per-direction loss"),
                       ("rate", "per-direction bandwidth")):
        p.add_argument(f"--{key}", help=help_)
    p.add_argument("--mtu", type=int, help="drop packets longer than this, silently")
    p.set_defaults(func=cmd_degrade)
    p = sub.add_parser("mtu", help="path-MTU black hole until heal: drop packets over BYTES between two sites")
    p.add_argument("link")
    p.add_argument("bytes", type=int)
    p.set_defaults(func=cmd_mtu)
    p = sub.add_parser("flap", help="take a link down and up repeatedly (foreground), e.g. flap a-b --period 10s")
    p.add_argument("link")
    p.add_argument("--period", default="10s", help="full down+up cycle (default 10s, at least 2s)")
    p.add_argument("--duration", help="stop after this long, e.g. 60s (default: until Ctrl-C)")
    p.set_defaults(func=cmd_flap)
    sub.add_parser("heal", help="undo every partition/degrade/mtu/flap: links back to their pre-fault state").set_defaults(
        func=cmd_heal
    )
    p = sub.add_parser("scenario", help="run a scripted experiment from scenarios/ and check its expectations")
    p.add_argument("name", nargs="?", help="scenario (omit, or --list, to list them)")
    p.add_argument("--list", action="store_true", help="list the scenarios")
    p.set_defaults(func=cmd_scenario)
    # argparse.REMAINDER drops leading options (`provision --check`, `kubectl -n demo get pods`), so these two take
    # the unknown ones
    args, extra = parser.parse_known_args()
    if extra and args.command not in ("provision", "kubectl"):
        parser.error(f"unrecognized arguments: {' '.join(extra)}")
    if args.command == "provision":
        args.ansible_args = extra + args.ansible_args
    if args.command == "kubectl":
        args.kubectl_args = extra + args.kubectl_args
    try:
        return args.func(args)
    except LabError as e:
        print(f"opsforge {args.command}: {e}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as e:
        print(f"opsforge {args.command}: '{' '.join(e.cmd)}' failed:\n{(e.stderr or '').strip()}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
