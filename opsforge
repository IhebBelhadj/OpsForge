def load_packs(conn=None):
    """[(path, pack document)] of every pack under labs/, raising LabError on the first invalid one."""
    found = []
    for path in labs.find_packs(LABS):
        doc = labs.load_pack(path)
        catalog = labsdb.catalog_ids(conn, doc["pack"].get("id")) if conn else None
        if errs := labs.errors(doc, catalog):
            raise LabError(f"{path.relative_to(ROOT)}: " + "; ".join(errs))
        found.append((path, doc))
    return found


def import_packs(conn):
    """Imports every pack and awards badges whose rules the history now meets; prints what changed."""
    for path, doc in load_packs(conn):
        try:
            summary = labsdb.import_pack(conn, doc, path.relative_to(ROOT))
        except ValueError as e:
            raise LabError(f"{path.relative_to(ROOT)}: {e}") from None
        changes = {k: v for k, v in summary["labs"].items() if v and k != "unchanged"}
        detail = "; ".join(f"{k} {', '.join(v)}" for k, v in changes.items()) or "no change"
        print(f"pack {doc['pack']['id']}: {len(doc['labs'])} labs, {len(doc['curricula'])} curricula ({detail})")
    if awarded := labsdb.award_badges(conn, labsdb.local_user(conn)):
        print(f"badges awarded from history: {', '.join(b['title'] for b in awarded)}")


def cmd_labs(args):
