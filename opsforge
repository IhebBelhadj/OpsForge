def upstream_dns():
    """incusbr0's resolver: wan-core forwards the lab's DNS there."""
    return incus("network", "get", "incusbr0", "ipv4.address").stdout.strip().split("/")[0]


def ensure_images():
    for alias, (base, script, description) in render.IMAGES.items():
        if exists(f"/1.0/images/aliases/{alias}"):
            continue
        print(f"Building image {alias} from {base} (one-time)...")
        build = "opsforge-build"
        incus("delete", "--force", build, check=False)
        incus("launch", base, build)
        try:
            incus("exec", build, "--", "sh", "-c", script)
            incus("stop", build)
            incus("publish", build, "--alias", alias, f"description={description}")
        finally:
            incus("delete", "--force", build, check=False)


def ssh_keygen(path, comment):
    if not path.exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", comment, "-f", str(path)], check=True)
    return path.read_text(), path.with_suffix(".pub").read_text()


def wg_keypair(site):
    """(private, public) WireGuard key of a site's gateway, base64 as `wg` uses them. Generated once with openssl
    (WireGuard keys are X25519 keys: the raw 32 bytes ending each key's DER encoding), kept across `down`."""
    pem = WG_KEYS / f"{site}.pem"
    if not pem.exists():
        WG_KEYS.mkdir(mode=0o700, parents=True, exist_ok=True)
        subprocess.run(["openssl", "genpkey", "-algorithm", "X25519", "-out", str(pem)], check=True, capture_output=True)
    der = [
        subprocess.run(["openssl", "pkey", "-in", str(pem), *flags, "-outform", "DER"], check=True, capture_output=True).stdout
        for flags in ([], ["-pubout"])
    ]
    return tuple(base64.b64encode(d[-32:]).decode() for d in der)


def lab_plan(topo):
    """render.plan with this host's upstream DNS and the gateways' real WireGuard keys."""
    keys = {site: wg_keypair(site) for site in topo["sites"]} if topo.get("interconnect") == "vpn" else None
    return render.plan(topo, upstream_dns(), keys)


def write_access(topo, instances):
    """Controller side of SSH and Ansible: keys, SSH config, known_hosts and inventory. Returns the client public key."""
    STATE.mkdir(mode=0o700, exist_ok=True)
    _, client_pub = ssh_keygen(SSH_KEY, "opsforge-controller")
    known = [f"{inst.name} {ssh_keygen(HOST_KEYS / inst.name, inst.name)[1]}" for inst in instances if inst.managed]
    KNOWN_HOSTS.write_text("".join(known))
    SSH_CONFIG.write_text(render.render_ssh_config(topo, SSH_KEY, KNOWN_HOSTS, SSH_DIR))
    INVENTORY.parent.mkdir(parents=True, exist_ok=True)
    inventory = render.render_inventory(topo, SSH_CONFIG, STATE)
    INVENTORY.write_text(render.HEADER + "\n" + yaml.safe_dump(inventory, sort_keys=False))
    return client_pub


def ssh(host, *cmd, timeout=10):
    return subprocess.run(
        ["ssh", "-F", str(SSH_CONFIG), "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", host, *cmd],
        capture_output=True, text=True, timeout=timeout, check=False,
    )


def ssh_ok(host):
    try:
        return ssh(host, "true").returncode == 0
    except subprocess.TimeoutExpired:
        return False


def desired_config(inst):
    """Instance config as `up` sets it: limits, the role/site tags and the fingerprint of its wiring and files."""
    tags = {"user.opsforge.role": inst.role} | ({"user.opsforge.site": inst.site} if inst.site else {})
    return inst.config | tags | {SPEC_KEY: render.fingerprint(inst)}


def config_changes(current, desired):
    return {k: v for k, v in desired.items() if current.get(k) != v}


def nic_changes(devices, nics):
    """(devices to remove, {device: network} to add) turning an instance's NIC devices into `nics`."""
    current = {name: dev.get("network") for name, dev in devices.items() if dev.get("type") == "nic"}
    remove = [name for name, net in current.items() if nics.get(name) != net]
    return remove, {name: net for name, net in nics.items() if current.get(name) != net}


def merge_link_state(live, desired):
    """wan-core's link state after a topology edit: sites and the set of links from topology.yml, but links that
    already exist keep their live conditions, so `up` never undoes `opsforge link` (`link --reset` does)."""
    return desired | {"links": {name: live["links"].get(name, link) for name, link in desired["links"].items()}}


def image_fingerprint(alias):
