def read_pre_fault():
    res = incus("file", "pull", f"{render.WAN_CORE}{PRE_FAULT}", "-", check=False)
    return json.loads(res.stdout) if res.returncode == 0 else None


def begin_fault(state):
    """Saves the live link state before the first fault (later faults stack on top), for `heal`."""
    if read_pre_fault() is None:
        push_file(render.WAN_CORE, PRE_FAULT, json.dumps(state, indent=2) + "\n", "0644")


def heal_links():
    """Every link back to its live state from before the first fault; False if there was no fault."""
    pre = read_pre_fault()
    if pre is None:
        return False
    state = read_link_state()
    state["links"] = {name: pre["links"].get(name, link) for name, link in state["links"].items()}
    apply_link_state(state)
    run_in(render.WAN_CORE, "rm", "-f", PRE_FAULT)
    return True


def cmd_partition(args):
    """Cuts a site off the other sites (100 % loss on each of its links). The site keeps its internet access and the
    host's management path."""
    topo = load_valid_topology()
    if args.site not in topo["sites"]:
        raise LabError(f"no site {args.site}; sites: {', '.join(topo['sites'])}")
    state = read_link_state()
    begin_fault(state)
    cut = sorted(n for n in state["links"] if args.site in n.split("-"))
    for name in cut:
        state["links"][name] = state["links"][name] | {"loss": "100%"}
    apply_link_state(state)
    print(f"site {args.site} partitioned: {', '.join(cut)} at 100 % loss (./opsforge heal restores them)")
    return 0


def degrade_link(spec, changes):
    state = read_link_state()
    name = find_link(state, spec)
    link = edit_link(state["links"][name], changes)
    begin_fault(state)
    state["links"][name] = link
    apply_link_state(state)
    return name, link


def cmd_degrade(args):
    """A link change that `heal` undoes (`link` changes are kept until `link --reset`)."""
    changes = {k: getattr(args, k) for k in LINK_KEYS if getattr(args, k) is not None}
    if not changes:
        raise LabError("nothing to change: give --rtt, --jitter, --loss, --rate or --mtu")
    name, link = degrade_link(args.link, changes)
    print(f"{name} degraded: {describe_link(link)} (./opsforge heal restores it)")
    return 0


def cmd_mtu(args):
    """Path-MTU black hole between two sites: packets longer than BYTES vanish, no ICMP tells the sender."""
    name, _ = degrade_link(args.link, {"mtu": args.bytes})
    print(f"{name}: packets over {args.bytes} bytes dropped silently (./opsforge heal restores it)")
    return 0


def flap_link(spec, period, duration=None, stop=None):
    """Takes a link down (100 % loss) and up again every period/2 seconds until `duration` has passed or `stop` (a
    threading.Event) is set, then restores it. A killed flap leaves the pre-fault state for `heal`."""
    state = read_link_state()
    name = find_link(state, spec)
    begin_fault(state)
    base = dict(state["links"][name])
    end = time.monotonic() + duration if duration else None
    down = False
    try:
        while not (stop and stop.is_set()) and (end is None or time.monotonic() < end):
            down = not down
            state = read_link_state()
            state["links"][name] = base | {"loss": "100%"} if down else base
            apply_link_state(state)
            if stop:
                stop.wait(period / 2)
            else:
                time.sleep(period / 2)
    finally:
        state = read_link_state()
        state["links"][name] = base
        apply_link_state(state)
        if read_pre_fault() == state:
            # This flap was the only fault: nothing left for heal to do
            run_in(render.WAN_CORE, "rm", "-f", PRE_FAULT)
    return name


def cmd_flap(args):
    period = render.time_us(args.period) / 1e6
    if period < 2:
        raise LabError("--period must be at least 2s (each change takes a fraction of a second)")
    duration = render.time_us(args.duration) / 1e6 if args.duration else None
    print(f"flapping {args.link}: down/up every {period / 2:g}s "
          f"{'for ' + args.duration if duration else 'until Ctrl-C'}", file=sys.stderr)
    try:
        name = flap_link(args.link, period, duration)
    except KeyboardInterrupt:
        name = args.link
    print(f"{name}: flapping stopped, link restored")
    return 0


def cmd_heal(args):
    """Restores every link to its live state from before the first fault (not to topology.yml)."""
    print("healed: links back to their pre-fault state" if heal_links() else "nothing to heal (no fault in place)")
    return 0


class ScenarioRun:
    """Runs scenario steps against the lab (lab/scenario.py describes the file format) and collects metrics."""

    def __init__(self, topo):
        self.topo = topo
        self.metrics = {}
        self.flapping = None  # (thread, stop event) of a background `flap` step
        self.start = time.monotonic()

    def log(self, phase, text):
        print(f"  {time.monotonic() - self.start:6.1f}s  [{phase}] {text}")

    def target(self, name):
        """A lab host's name -> its private address (a gateway's VPC address); anything else unchanged."""
        name = scenario.substitute(str(name), self.topo)
        if name in render.node_addresses(self.topo) or name.endswith("-gw"):
            return scenario.substitute(f"${{ip:{name}}}", self.topo)
        return name

    def shell(self, on, cmd, timeout):
        """(exit code, stdout) of a shell command on the host (from the repo root, so ./opsforge works) or in an
        instance."""
        cmd = scenario.substitute(cmd, self.topo)
        on = scenario.substitute(on, self.topo)
        if on == "host":
            try:
                res = subprocess.run(["bash", "-c", cmd], cwd=ROOT, stdin=subprocess.DEVNULL, capture_output=True,
                                     text=True, timeout=timeout)
            except subprocess.TimeoutExpired:
                return 124, ""
        else:
            res = run_in(on, "timeout", str(int(timeout)), "sh", "-c", cmd)
        return res.returncode, res.stdout

    def promql(self, query):
        mon = render.monitoring_node(self.topo)
        if mon is None:
            raise LabError("promql steps need a monitoring node")
        data = vm_query(mon, "/api/v1/query", query=query)
        return float(data["result"][0]["value"][1]) if data and data["result"] else None

    def step(self, phase, step):
        kind = scenario.step_type(step)
        arg = step[kind]
        name = step.get("name")
        shown = arg if not isinstance(arg, dict) else " ".join(f"{k}={v}" for k, v in arg.items())
        self.log(phase, f"{kind} {scenario.substitute(str(shown), self.topo)}" + (f"  -> {name}" if name else ""))
        got = {}
        if kind == "sleep":
            time.sleep(scenario.seconds(arg))
        elif kind == "partition":
            cmd_partition(argparse.Namespace(site=str(arg)))
        elif kind == "heal":
            heal_links()
        elif kind in ("degrade", "mtu"):
            changes = {"mtu": arg["bytes"]} if kind == "mtu" else {k: arg[k] for k in LINK_KEYS if k in arg}
            degrade_link(arg["link"], changes)
        elif kind == "flap":
            stop = threading.Event()
            period = scenario.seconds(arg.get("period", "10s"))
            thread = threading.Thread(target=flap_link, args=(arg["link"], period), kwargs={"stop": stop}, daemon=True)
            thread.start()
            self.flapping = (thread, stop)
        elif kind == "stop_flap":
            self.stop_flap()
        elif kind == "run":
            began = time.monotonic()
            code, out = self.shell(arg.get("host", "host"), arg["cmd"], scenario.seconds(arg.get("timeout", 300)))
            got = {"exit": code, "seconds": time.monotonic() - began}
            last = out.strip().splitlines()[-1] if out.strip() else ""
            if re.fullmatch(r"-?\d+(\.\d+)?", last):
                got["value"] = float(last)
        elif kind == "ping":
            count, interval = int(arg.get("count", 20)), arg.get("interval", 0.2)
            out = run_in(scenario.substitute(arg["from"], self.topo), "ping", "-q", "-c", str(count), "-i", str(interval), self.target(arg["to"])).stdout
            got = scenario.parse_ping(out)
        elif kind == "http":
            count, timeout = int(arg.get("count", 10)), scenario.seconds(arg.get("timeout", 10))
            url = scenario.substitute(arg["url"], self.topo)
            loop = (f"for i in $(seq {count}); do curl -s -o /dev/null -m {timeout:g} "
                    f"-w '%{{http_code}} %{{time_total}}\\n' '{url}'; done")
            got = scenario.parse_http(run_in(scenario.substitute(arg["from"], self.topo), "sh", "-c", loop).stdout)
        elif kind == "transfer":
            timeout = scenario.seconds(arg.get("timeout", 30))
            res = run_in(scenario.substitute(arg["from"], self.topo), "curl", "-s", "-o", "/dev/null", "-m", f"{timeout:g}", "-w",
                         "%{http_code} %{size_download} %{time_total}", scenario.substitute(arg["url"], self.topo))
            got = scenario.parse_transfer(res.stdout, res.returncode)
        elif kind == "wait_until":
            timeout, interval = scenario.seconds(arg.get("timeout", 300)), scenario.seconds(arg.get("interval", 2))
            began, ok = time.monotonic(), False
            while not ok and time.monotonic() - began < timeout:
                if "promql" in arg:
                    value = self.promql(arg["promql"])
                    ok = value is not None and scenario.check("v", arg["until"], {"v": value})[0]
                else:
                    ok = self.shell(arg.get("host", "host"), arg["cmd"], min(timeout, 60))[0] == 0
                if not ok:
                    time.sleep(interval)
            got = {"ok": int(ok), "seconds": time.monotonic() - began}
        elif kind == "promql":
            value = self.promql(arg["query"])
            got = {} if value is None else {"value": value}
        if name:
            self.metrics |= {f"{name}.{k}": v for k, v in got.items()}
            if got:
                self.log(phase, "    " + ", ".join(f"{k}={v:.4g}" for k, v in got.items()))

    def stop_flap(self):
        if self.flapping:
            thread, stop = self.flapping
            stop.set()
            thread.join()
            self.flapping = None


def cmd_scenario(args):
    """Runs a scripted experiment (scenarios/<name>.yml) and checks its expectations; the links are always healed."""
    files = {f.stem: f for f in sorted(SCENARIOS.glob("*.yml"))}
    if args.list or not args.name:
        for name, path in files.items():
            doc = yaml.safe_load(path.read_text())
            only = f"[{doc['layout']}] " if "layout" in doc else ""
            print(f"{name:<24} {only}{' '.join(str(doc.get('description', '')).split())}")
        return 0
    if args.name not in files:
        raise LabError(f"no scenario {args.name}; scenarios: {', '.join(files)}")
    doc = yaml.safe_load(files[args.name].read_text())
    if errs := scenario.errors(doc):
        raise LabError(f"{files[args.name].relative_to(ROOT)}: " + "; ".join(errs))
    topo = load_valid_topology()
    if doc.get("layout", scenario.layout(topo)) != scenario.layout(topo):
        print(f"Scenario {args.name} skipped: needs the {doc['layout']} layout, {TOPOLOGY.name} is "
              f"{scenario.layout(topo)}")
        return 0
    if read_pre_fault() is not None:
        raise LabError("a fault is in place (./opsforge heal first): the scenario would heal it")
    print(f"Scenario {args.name}: {' '.join(str(doc['description']).split())}")
    run = ScenarioRun(topo)
    error = None
    try:
        for phase in ("setup", "fault", "measure"):
            for step in doc.get(phase) or []:
                run.step(phase, step)
    except (LabError, subprocess.CalledProcessError, KeyboardInterrupt) as e:
        error = f"{type(e).__name__}: {e}"
        print(f"  step failed: {error}")
    finally:
        run.stop_flap()
        heal_links()
        for step in doc.get("teardown") or []:
            try:
                run.step("teardown", step)
            except (LabError, subprocess.CalledProcessError) as e:
                print(f"  teardown step failed: {e}")
    print("Expectations")
    results, passed = [], error is None
    for metric, condition in scenario.expectations(doc):
        ok, value, threshold = scenario.check(metric, condition, run.metrics)
        passed &= ok
        shown = "missing" if value is None else f"{value:.4g}"
        bound = "" if threshold is None or re.fullmatch(r"[<>=!]+\s*[\d.]+", str(condition)) else f" (= {threshold:.4g})"
        verdict = "\033[32mPASS\033[0m" if ok else "\033[31mFAIL\033[0m"
        print(f"  {verdict}  {metric} = {shown}, want {condition}{bound}")
        results.append({"metric": metric, "condition": str(condition), "value": value, "passed": ok})
    RESULTS.mkdir(parents=True, exist_ok=True)
    previous = sorted(RESULTS.glob(f"{args.name}-*.json"))
    out = RESULTS / f"{args.name}-{time.strftime('%Y%m%d-%H%M%S')}.json"
    out.write_text(json.dumps({
        "scenario": args.name, "finished": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "passed": passed, "error": error,
        "seconds": round(time.monotonic() - run.start, 1), "metrics": run.metrics, "expectations": results,
    }, indent=2) + "\n")
    if previous and (moved := scenario.compare(json.loads(previous[-1].read_text())["metrics"], run.metrics)):
        print(f"Since the last run ({previous[-1].name})")
        for line in moved:
            print(f"  {line}")
    print(f"\nScenario {args.name} " + ("\033[32mpassed\033[0m" if passed else "\033[31mFAILED\033[0m")
          + f" ({out.relative_to(ROOT)})")
    return 0 if passed else 1


