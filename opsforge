    res = run_in(mon, "curl", "-sf", "-G", url, *args)
    return json.loads(res.stdout)["data"] if res.returncode == 0 else None


def check_monitoring(r, topo):
    """Every scrape target up, a successful ICMP probe for every ordered site pair, Grafana healthy."""
    mon = render.monitoring_node(topo)
    print(f"Monitoring ({mon}: every scrape target up, every site pair probed, Grafana healthy)")
    targets = vm_query(mon, "/api/v1/targets")
    if targets is None:
        r.fail(f"{mon}: VictoriaMetrics does not answer on port {VM_PORT}")
        return
    jobs = {}
    for t in targets["activeTargets"]:
        jobs.setdefault(t["labels"]["job"], []).append(t)
    for job, ts in sorted(jobs.items()):
        down = [f"{t['scrapeUrl']} ({t.get('lastError', '')[:80]})" for t in ts if t["health"] != "up"]
        (r.fail if down else r.ok)(f"{job}: {len(ts) - len(down)}/{len(ts)} targets up" +
                                   (f"; down: {', '.join(down)}" if down else ""))
    probes = vm_query(mon, "/api/v1/query", query='probe_success{job="wan_icmp"}') or {"result": []}
    ok = {(p["metric"]["src"], p["metric"]["dst"]) for p in probes["result"] if p["value"][1] == "1"}
    pairs = [(a, b) for a in topo["sites"] for b in topo["sites"] if a != b]
    missing = [f"{a}->{b}" for a, b in pairs if (a, b) not in ok]
    (r.fail if missing else r.ok)(f"wan_icmp: {len(pairs) - len(missing)}/{len(pairs)} site pairs answering" +
                                  (f"; failing: {', '.join(missing)}" if missing else ""))
    health = run_in(mon, "curl", "-sf", f"http://127.0.0.1:{GRAFANA_PORT}/api/health")
    (r.ok if health.returncode == 0 else r.fail)(
        f"Grafana {json.loads(health.stdout)['version'] if health.returncode == 0 else 'not answering'} "
        f"(./opsforge forward {mon}:{GRAFANA_PORT})"
    )


