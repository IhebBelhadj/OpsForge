def cmd_ssh(args):
    if not SSH_CONFIG.exists():
        raise LabError("no SSH config yet: run ./opsforge up")
    os.execvp("ssh", ["ssh", "-F", str(SSH_CONFIG), args.host, *args.command])


def parse_forward(spec):
    """`<host>:<port>` -> (host, port)."""
    host, sep, port = spec.rpartition(":")
    if not sep or not host or not port.isdigit() or not 0 < int(port) < 65536:
        raise LabError(f"expected <host>:<port>, e.g. a-cp1:6443, got {spec!r}")
    return host, int(port)


def default_local_port(port):
    """Same port locally, unless it is privileged (needs root to bind): 80 -> 10080, 443 -> 10443."""
    return port if port >= 1024 else port + 10000


def forward_socket(local):
    return FORWARDS / f"{local}.sock"


def ssh_control(sock, op, host):
    return subprocess.run(
        ["ssh", "-F", str(SSH_CONFIG), "-S", str(sock), "-O", op, host], capture_output=True, text=True
    ).returncode == 0


def active_forwards():
    """Running tunnels, as recorded by start_forward; records whose ssh has died are removed."""
    forwards = []
    for path in sorted(FORWARDS.glob("*.json")) if FORWARDS.exists() else ():
        fwd = json.loads(path.read_text())
        if ssh_control(forward_socket(fwd["local"]), "check", fwd["host"]):
            forwards.append(fwd)
        else:
            path.unlink()
            forward_socket(fwd["local"]).unlink(missing_ok=True)
    return forwards


def describe_forward(fwd):
    return f"127.0.0.1:{fwd['local']} -> {fwd['host']} {fwd['to']}:{fwd['port']}"


def start_forward(host, port, local, to):
    """Background `ssh -L` with its own control socket, over the usual path (wan-core, then the site gateway)."""
    if any(f["local"] == local for f in active_forwards()):
        raise LabError(f"127.0.0.1:{local} is already forwarded (./opsforge forward --list)")
    FORWARDS.mkdir(parents=True, exist_ok=True)
    fwd = {"host": host, "port": port, "local": local, "to": to}
    # Not a pipe: `ssh -f` (and its ProxyJump child) keep stderr open after backgrounding, so reading a pipe hangs
    with tempfile.TemporaryFile("w+") as err:
        res = subprocess.run(
            [
                "ssh", "-F", str(SSH_CONFIG), "-f", "-N", "-M", "-S", str(forward_socket(local)),
                "-o", "ControlPersist=no", "-o", "ExitOnForwardFailure=yes",
                "-L", f"127.0.0.1:{local}:{to}:{port}", host,
            ],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=err,
        )
        err.seek(0)
        if res.returncode != 0:
            raise LabError(f"forward {host}:{port} failed: {err.read().strip()}")
    (FORWARDS / f"{local}.json").write_text(json.dumps(fwd) + "\n")
    return fwd


def stop_forward(fwd):
    ssh_control(forward_socket(fwd["local"]), "exit", fwd["host"])
    (FORWARDS / f"{fwd['local']}.json").unlink(missing_ok=True)
    forward_socket(fwd["local"]).unlink(missing_ok=True)
    print(f"  stopped {describe_forward(fwd)}")


def cmd_forward(args):
    """Reach a lab service from the host: tunnels bind 127.0.0.1 only and need neither sudo nor a route into the lab."""
    if args.stop:
        target = parse_forward(args.target) if args.target else None
        for fwd in active_forwards():
            if target is None or (fwd["host"], fwd["port"]) == target:
                stop_forward(fwd)
        return 0
    if args.list or not args.target:
        forwards = active_forwards()
        for fwd in forwards:
            print(describe_forward(fwd))
        if not forwards:
            print("No forwards (./opsforge forward <host>:<port>)")
        return 0
    if not SSH_CONFIG.exists():
        raise LabError("no SSH config yet: run ./opsforge up")
    host, port = parse_forward(args.target)
    fwd = start_forward(host, port, args.local or default_local_port(port), args.to)
    print(describe_forward(fwd))
    return 0


def capture_cmd(iface, count, seconds, bpf):
    """tcpdump in an instance, writing the pcap to stdout unbuffered (-U) so an interrupted capture keeps what it
    saw. `timeout` sends SIGTERM, on which tcpdump flushes and prints its statistics."""
    cmd = ["tcpdump", "-i", iface, "-n", "-p", "-U", "-w", "-"]
    if count:
        cmd += ["-c", str(count)]
    if bpf:
        cmd.append(" ".join(bpf))
    return ["timeout", str(seconds), *cmd] if seconds else cmd


def cmd_capture(args):
    """Packet evidence: runs tcpdump inside a lab instance and saves the pcap on the host."""
    if args.instance not in {i["name"] for i in lab_instances()}:
        raise LabError(f"{args.instance} is not a running lab instance (./opsforge status)")
    CAPTURES.mkdir(parents=True, exist_ok=True)
    out = args.output or CAPTURES / f"{args.instance}-{time.strftime('%Y%m%d-%H%M%S')}.pcap"
    tcpdump = capture_cmd(args.iface, args.count, args.duration, args.filter)
    until = f"{args.duration} s" if args.duration else "Ctrl-C"
    print(f"capturing on {args.instance} {args.iface} ({' '.join(args.filter) or 'all traffic'}) until {until}"
          + (f" or {args.count} packets" if args.count else ""), file=sys.stderr)
    with open(out, "wb") as f:
        proc = subprocess.Popen(["incus", "exec", args.instance, "--", *tcpdump], stdout=f, stderr=subprocess.PIPE)
        try:
            _, err = proc.communicate()
        except KeyboardInterrupt:
            # Ctrl-C also reaches incus, which forwards it to tcpdump: let it flush and exit
            _, err = proc.communicate()
    err = err.decode(errors="replace")
    # 124: stopped by `timeout`; tcpdump itself exits 0 (count reached) or 130/143 on a signal
    if proc.returncode not in (0, 124, 130, 143) or "packets captured" not in err:
        Path(out).unlink(missing_ok=True)
        raise LabError(f"tcpdump on {args.instance} failed: {err.strip()}")
    stats = [line for line in err.splitlines() if "packets" in line]
    print(f"{out}  ({'; '.join(stats)})")
    if args.show:
        decode = ["tcpdump", "-n", "-r", "-", *(["-q"] if args.show == "brief" else [])]
        with open(out, "rb") as f:
            res = subprocess.run(["incus", "exec", args.instance, "--", *decode], stdin=f, capture_output=True, text=True)
        print(res.stdout, end="")
    return 0


def cmd_provision(args):
    """Runs ansible/site.yml against the lab over SSH, with a freshly rendered inventory."""
    topo = load_valid_topology()
    if not lab_instances():
        raise LabError("lab is down (./opsforge up)")
    write_access(topo, lab_plan(topo)[1])
    return subprocess.run(["ansible-playbook", "site.yml", *args.ansible_args], cwd=ANSIBLE_DIR).returncode


# Commands planned in docs/PLAN.md, with the phase that implements them.
PLANNED = {
    "partition": ("cut a site off the WAN", 6),
    "heal": ("restore all links", 6),
    "flap": ("periodically drop a link", 6),
}


def main():
    parser = argparse.ArgumentParser(prog="opsforge", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("validate", help="validate topology.yml")
    p.add_argument("topology", nargs="?", default=TOPOLOGY, type=Path)
    p.set_defaults(func=cmd_validate)
    sub.add_parser("preflight", help="check the host is ready to run the lab").set_defaults(func=cmd_preflight)
    sub.add_parser("smoke", help="launch a throwaway container to prove Incus networking works").set_defaults(
        func=cmd_smoke
    )
    sub.add_parser("up", help="create the lab, or apply topology.yml edits to it").set_defaults(func=cmd_up)
    p = sub.add_parser("down", help="destroy the lab")
    p.add_argument("--purge", action="store_true", help=f"also delete the cached {', '.join(render.IMAGES)} images")
    p.set_defaults(func=cmd_down)
    p = sub.add_parser("gc", help="delete images built by older opsforge versions (old opsforge-* aliases)")
    p.add_argument("--dry-run", action="store_true", help="only list what would be deleted")
    p.set_defaults(func=cmd_gc)
    p = sub.add_parser("snapshot", help="snapshot every lab instance under one name, e.g. after provision")
    p.add_argument("name", nargs="?", help="snapshot name (default: the current time, YYYYmmdd-HHMMSS)")
    p.add_argument("--list", action="store_true", help="list the lab's snapshots")
    p.add_argument("--delete", action="store_true", help="delete the named snapshot from every instance")
    p.set_defaults(func=cmd_snapshot)
    p = sub.add_parser("restore", help="roll the whole lab back to a snapshot (restarts every instance)")
    p.add_argument("name")
    p.set_defaults(func=cmd_restore)
    sub.add_parser("status", help="show instances, memory and live link conditions").set_defaults(func=cmd_status)
    p = sub.add_parser("link", help="show or change a WAN link's conditions live, e.g. link a-b --rtt 200ms")
    p.add_argument("link", nargs="?", help="site pair, e.g. a-b (omit with --reset to reset every link)")
    p.add_argument("--rtt", help="round-trip time, e.g. 80ms")
    p.add_argument("--jitter", help="RTT standard deviation, e.g. 10ms (0ms disables)")
    p.add_argument("--loss", help="per-direction packet loss, e.g. 0.5%% (0%% disables)")
    p.add_argument("--rate", help="per-direction bandwidth, e.g. 20mbit")
    p.add_argument("--save", action="store_true", help="also write the link's conditions to topology.yml")
    p.add_argument("--reset", action="store_true", help="revert the link (or every link) to topology.yml")
    p.set_defaults(func=cmd_link)
    p = sub.add_parser("verify", help="check latency, isolation, internet and bandwidth against the live links")
    p.add_argument("--quick", action="store_true", help="skip the bandwidth test")
    p.add_argument(
        "--mem", nargs="?", type=int, const=MEM_CEILING_MIB, metavar="MIB",
        help=f"also fail if the lab's non-reclaimable memory exceeds MIB (default {MEM_CEILING_MIB})",
    )
    p.add_argument(
        "--disk", nargs="?", type=float, const=DISK_CEILING_GIB, metavar="GIB",
        help=f"also fail if the storage pool's used space exceeds GIB (default {DISK_CEILING_GIB})",
    )
    p.set_defaults(func=cmd_verify)
    sub.add_parser("render", help="print the generated networks, instances and config files").set_defaults(
        func=cmd_render
    )
    p = sub.add_parser("provision", help="configure the lab with Ansible (ansible/site.yml) over SSH")
    p.add_argument("ansible_args", nargs=argparse.REMAINDER, help="passed to ansible-playbook, e.g. --check --diff")
    p.set_defaults(func=cmd_provision)
    p = sub.add_parser("ssh", help="ssh to a lab host through wan-core and its site gateway, e.g. ssh b-w1")
    p.add_argument("host")
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_ssh)
    p = sub.add_parser("forward", help="tunnel a lab service to 127.0.0.1 on the host, e.g. forward a-cp1:6443")
    p.add_argument("target", nargs="?", help="<host>:<port> (with --stop: only that forward)")
    p.add_argument("--local", type=int, help="local port (default: the same port, +10000 below 1024)")
    p.add_argument("--to", default="127.0.0.1", help="address the lab host connects to (default its own 127.0.0.1)")
    p.add_argument("--list", action="store_true", help="list running forwards")
    p.add_argument("--stop", action="store_true", help="stop the forward to <host>:<port>, or every forward")
    p.set_defaults(func=cmd_forward)
    p = sub.add_parser(
        "capture", help="tcpdump inside a lab instance into a pcap on the host, e.g. capture wan-core udp port 51820"
    )
    p.add_argument("instance", help="lab instance, e.g. wan-core, a-gw, b-w1")
    p.add_argument("filter", nargs="*", help="tcpdump (BPF) filter, e.g. icmp or 'udp port 53'")
    p.add_argument("-i", "--iface", default="any", help="interface (default any)")
    p.add_argument("-d", "--duration", type=int, default=10, help="seconds to capture, 0 = until Ctrl-C (default 10)")
    p.add_argument("-c", "--count", type=int, help="stop after this many packets")
    p.add_argument("-o", "--output", type=Path, help=f"pcap path (default {CAPTURES.relative_to(ROOT)}/<instance>-<time>.pcap)")
    p.add_argument("--show", nargs="?", const="brief", choices=("brief", "full"),
                   help="also print the packets (decoded by the instance's tcpdump)")
    p.set_defaults(func=cmd_capture)
    for name, (desc, phase) in PLANNED.items():
        p = sub.add_parser(name, help=f"{desc} (Phase {phase}, not implemented)")
        p.add_argument("args", nargs=argparse.REMAINDER)
        p.set_defaults(func=lambda a, n=name, ph=phase: sys.exit(f"opsforge {n}: not implemented yet (Phase {ph})"))

    # argparse.REMAINDER drops leading options (`provision --check`), so provision takes the unknown ones
    args, extra = parser.parse_known_args()
    if extra and args.command != "provision":
        parser.error(f"unrecognized arguments: {' '.join(extra)}")
    if args.command == "provision":
        args.ansible_args = extra + args.ansible_args
    try:
        return args.func(args)
    except LabError as e:
        print(f"opsforge {args.command}: {e}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as e:
        print(f"opsforge {args.command}: '{' '.join(e.cmd)}' failed:\n{(e.stderr or '').strip()}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
