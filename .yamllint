extends: default

ignore: |
  .git/
  .opsforge/
  ansible/inventory/

rules:
  line-length:
    max: 120
  document-start: disable
  truthy:
    check-keys: false
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  # ansible-lint requires these
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
