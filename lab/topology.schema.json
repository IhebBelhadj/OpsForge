{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpsForge lab topology",
  "type": "object",
  "required": ["transit", "sites", "links", "nodes"],
  "additionalProperties": false,
  "properties": {
    "transit": { "$ref": "#/$defs/cidr" },
    "interconnect": {
      "$comment": "vpn: WireGuard full mesh between the site gateways (routed VPC-to-VPC); none (default): VPCs isolated",
      "enum": ["vpn", "none"]
    },
    "routing": {
      "$comment": "with interconnect vpn: ospf (default) reroutes VPC traffic around a dead link through another site; static does not",
      "enum": ["ospf", "static"]
    },
    "sites": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": { "$comment": "short: becomes part of interface names (of-<site>, max 15 chars)", "pattern": "^[a-z][a-z0-9]{0,5}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["vpc", "public_ip"],
        "additionalProperties": false,
        "properties": {
          "vpc": { "$ref": "#/$defs/cidr" },
          "public_ip": { "type": "string", "format": "ipv4" }
        }
      }
    },
    "links": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]{0,5}-[a-z][a-z0-9]{0,5}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["rtt"],
        "additionalProperties": false,
        "properties": {
          "rtt": { "$ref": "#/$defs/duration" },
          "jitter": { "$ref": "#/$defs/duration" },
          "loss": { "type": "string", "pattern": "^\\d+(\\.\\d+)?%$" },
          "rate": { "type": "string", "pattern": "^\\d+(kbit|mbit|gbit)$" },
          "mtu": {
            "$comment": "path-MTU black hole: packets longer than this are dropped, with no ICMP (opsforge mtu)",
            "type": "integer", "minimum": 576, "maximum": 9000
          }
        }
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$" },
      "additionalProperties": {
        "type": "object",
        "required": ["site", "role"],
        "additionalProperties": false,
        "properties": {
          "site": { "type": "string" },
          "role": { "enum": ["k3s-server", "k3s-agent", "monitoring", "ci", "plain"] },
          "cluster": {
            "$comment": "K3s nodes only: the cluster they join (default lab, one cluster stretched over its sites)",
            "type": "string", "pattern": "^[a-z][a-z0-9-]{0,14}$"
          },
          "cpu": { "type": "integer", "minimum": 1, "maximum": 16 },
          "memory": { "type": "string", "pattern": "^\\d+(MiB|GiB)$" },
          "expose": {
            "$comment": "port forwards on the site gateway's public IP: <public>[:<private>][/tcp|udp]",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^\\d{1,5}(:\\d{1,5})?(/(tcp|udp))?$" }
          }
        }
      }
    }
  },
  "$defs": {
    "cidr": { "type": "string", "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}$" },
    "duration": { "type": "string", "pattern": "^\\d+(\\.\\d+)?(us|ms|s)$" }
  }
}
