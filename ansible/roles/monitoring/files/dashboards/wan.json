{
  "uid": "opsforge-wan",
  "title": "WAN: site-to-site",
  "description": "Measured between every site pair by the blackbox exporter on the source site's gateway (src = row, dst = column). Compare with `./opsforge status` (configured links).",
  "tags": [
    "opsforge"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "RTT (ms), through the VPN",
      "description": "Latest ICMP round trip from the src gateway to the dst gateway's private address: follows OSPF reroutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "probe_icmp_duration_seconds{job=\"wan_icmp\",phase=\"rtt\"} * 1000",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "custom": {
            "cellOptions": {
              "type": "color-background"
            },
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "src\\dst"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {},
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "src",
            "columnField": "dst",
            "valueField": "Value",
            "emptyValue": "null"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Loss (%), last 5 min",
      "description": "Share of failed one-packet ICMP probes over 5 minutes (one probe per 15 s: coarse below a few %).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * (1 - avg_over_time(probe_success{job=\"wan_icmp\"}[5m]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "custom": {
            "cellOptions": {
              "type": "color-background"
            },
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "src\\dst"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {},
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "src",
            "columnField": "dst",
            "valueField": "Value",
            "emptyValue": "null"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "HTTP to the site's ingress (ms)",
      "description": "Full GET of the dst site's public IP (port 80) from the src gateway, across the WAN: TCP + HTTP round trips.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "probe_duration_seconds{job=\"wan_http\"} * 1000",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "red",
                "value": 800
              }
            ]
          },
          "custom": {
            "cellOptions": {
              "type": "color-background"
            },
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "src\\dst"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {},
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "src",
            "columnField": "dst",
            "valueField": "Value",
            "emptyValue": "null"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "RTT by site pair",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "probe_icmp_duration_seconds{job=\"wan_icmp\",phase=\"rtt\"} * 1000",
          "refId": "A",
          "legendFormat": "{{src}} \u2192 {{dst}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "TCP connect to the peer's public IP",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "probe_duration_seconds{job=\"wan_tcp\"} * 1000",
          "refId": "A",
          "legendFormat": "{{src}} \u2192 {{dst}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Probes failing",
      "description": "1 while a probe fails, e.g. during `opsforge partition`.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (src, dst, job) (1 - probe_success{job=~\"wan_.*\"})",
          "refId": "A",
          "legendFormat": "{{job}} {{src}} \u2192 {{dst}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "templating": {
    "list": []
  }
}
