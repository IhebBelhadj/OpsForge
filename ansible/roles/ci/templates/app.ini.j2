; {{ ansible_managed }}
; Gitea for the lab: SQLite, HTTP only (the VPN encrypts between sites), Actions on, no outside calls.
APP_NAME = OpsForge lab
RUN_USER = git
RUN_MODE = prod
WORK_PATH = /var/lib/gitea

[server]
PROTOCOL = http
HTTP_PORT = {{ ci_gitea_port }}
DOMAIN = {{ ci_fqdn }}
ROOT_URL = {{ ci_gitea_url }}/
; Git over HTTP only
DISABLE_SSH = true
START_SSH_SERVER = false
OFFLINE_MODE = true
LFS_START_SERVER = false

[database]
DB_TYPE = sqlite3
PATH = /var/lib/gitea/data/gitea.db
SQLITE_JOURNAL_MODE = WAL

[security]
INSTALL_LOCK = true
SECRET_KEY = {{ ci_gitea_secret_key }}
INTERNAL_TOKEN = {{ ci_gitea_internal_token }}

[oauth2]
ENABLED = false
JWT_SECRET = {{ ci_gitea_jwt_secret }}

[service]
DISABLE_REGISTRATION = true
REQUIRE_SIGNIN_VIEW = false
DEFAULT_KEEP_EMAIL_PRIVATE = true

[repository]
DEFAULT_BRANCH = main

[actions]
ENABLED = true

[mailer]
ENABLED = false

[picture]
DISABLE_GRAVATAR = true

[cron.update_checker]
ENABLED = false

[log]
MODE = console
LEVEL = Warn
