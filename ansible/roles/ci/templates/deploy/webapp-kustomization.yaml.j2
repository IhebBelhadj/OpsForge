apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: webapp
# Base for every cluster (clusters/<name> adds the database or a link to it, and the replica count)
resources:
  - namespace.yaml
  - webapp.yaml
# newTag is set by the webapp repository's pipeline after each build
images:
  - name: webapp
    newName: {{ ci_registry }}/{{ ci_admin_user }}/{{ ci_app_repo }}
    newTag: "none"
