# Cluster {{ ci_cluster }} has no database: the Listener makes the one in cluster {{ ci_db_cluster }} a local Service,
# postgres.{{ ci_skupper_namespace }}, through Skupper (across the WAN, over the link between the clusters)
apiVersion: skupper.io/v2alpha1
kind: Listener
metadata:
  name: postgres
  namespace: {{ ci_skupper_namespace }}
spec:
  routingKey: postgres
  host: postgres
  port: 5432
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres
  namespace: webapp
stringData:
  url: postgres://webapp:{{ ci_db_password }}@postgres.{{ ci_skupper_namespace }}:5432/webapp?sslmode=disable
